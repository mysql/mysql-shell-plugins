  "query": "with recursive `rental_dates` as (/* select#2 */ select min(`sakila`.`rental`.`rental_date`) AS `rental_date` from `sakila`.`rental` union all /* select#3 */ select (`rental_dates`.`rental_date` + interval 1 day) AS `DATE_ADD(rental_date, INTERVAL 1 DAY)` from `rental_dates` where (`rental_dates`.`rental_date` < (/* select#4 */ select max(`sakila`.`rental`.`rental_date`) from `sakila`.`rental`))), `active_customers` as (/* select#5 */ select `c`.`customer_id` AS `customer_id`,`c`.`first_name` AS `first_name`,`c`.`last_name` AS `last_name` from `sakila`.`customer` `c` where exists(/* select#6 */ select 1 from `sakila`.`rental` `r` where ((`r`.`customer_id` = `c`.`customer_id`) and (`r`.`return_date` is null)))), `high_value_customers` as (/* select#7 */ select `sakila`.`payment`.`customer_id` AS `customer_id` from `sakila`.`payment` group by `sakila`.`payment`.`customer_id` having (sum(`sakila`.`payment`.`amount`) > 200)), `joined_customers` as (/* select#8 */ select `ac`.`customer_id` AS `customer_id`,`ac`.`first_name` AS `first_name`,`ac`.`last_name` AS `last_name` from `active_customers` `ac` join `high_value_customers` `hc` where (`ac`.`customer_id` = `hc`.`customer_id`)), `film_union` as (/* select#9 */ select `f`.`film_id` AS `film_id`,`f`.`title` AS `title`,'PG' AS `rating_source`,`f`.`metadata` AS `metadata`,`f`.`release_year` AS `release_year` from `sakila`.`film` `f` where (`f`.`rating` = 'PG') union all /* select#10 */ select `f`.`film_id` AS `film_id`,`f`.`title` AS `title`,'PG-13' AS `rating_source`,`f`.`metadata` AS `metadata`,`f`.`release_year` AS `release_year` from `sakila`.`film` `f` where (`f`.`rating` = 'PG-13')) /* select#1 */ select `jc`.`first_name` AS `first_name`,`jc`.`last_name` AS `last_name`,`f`.`title` AS `title`,json_unquote(json_extract(`f`.`metadata`,'$.length_category')) AS `length_category`,rank() OVER (PARTITION BY `jc`.`customer_id` ORDER BY `f`.`title` )  AS `film_rank`,sum(`p`.`amount`) OVER (PARTITION BY `jc`.`customer_id` )  AS `total_payment`,(/* select#11 */ select count(0) from `sakila`.`rental` `r2` where ((`r2`.`customer_id` = `jc`.`customer_id`) and (`r2`.`rental_date` > <cache>((now() - interval 6 month))))) AS `rentals_last_6mo` from `joined_customers` `jc` join `sakila`.`payment` `p` join `sakila`.`rental` `r` join `sakila`.`inventory` `i` join `film_union` `f` where ((`jc`.`customer_id` = `p`.`customer_id`) and (`jc`.`customer_id` = `r`.`customer_id`) and (`r`.`inventory_id` = `i`.`inventory_id`) and (`i`.`film_id` = `f`.`film_id`) and (`f`.`release_year` = 1900) and exists(/* select#12 */ select 1 from `sakila`.`store` `s` where (`s`.`store_id` = `i`.`store_id`)) and not exists(/* select#13 */ select 1 from `sakila`.`staff` `st` where ((`st`.`store_id` = `i`.`store_id`) and (`st`.`active` = 0)))) order by `jc`.`last_name`,`f`.`title` limit 25",
