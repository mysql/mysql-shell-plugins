            />
            <div>
              <h1>
                Client Connections
              </h1>
              <div
                class="clientConnectionsVersion"
              />
            </div>
          </div>
          <div
            class="clientConnectionPrimaryMetrics"
          >
            <div
              class="clientConnectionMetric primary"
            >
              <span>
                Threads Connected / Limit
              </span>
              <label
                class="msg label"
                data-testid="threadsConnected"
                data-tooltip="expand"
              >
                <span />
                <span
                  class="clientConnectionLimitValue"
                />
              </label>
              <label
                class="msg label clientConnectionHiddenMetric"
                data-testid="connectionsLimit"
                data-tooltip="expand"
              />
            </div>
          </div>
        </div>
        <div
          id="connectionProps"
        >
          <div
            class="clientConnectionMetric"
          >
            <span>
              Threads Running
            </span>
            <label
              class="msg label"
              data-testid="threadsRunning"
              data-tooltip="expand"
            />
          </div>
          <div
            class="clientConnectionMetric"
          >
            <span>
              Threads Cached
            </span>
            <label
              class="msg label"
              data-testid="threadsCached"
              data-tooltip="expand"
            />
          </div>
          <div
            class="clientConnectionMetric"
          >
            <span>
              Rejected (over limit)
            </span>
            <label
              class="msg label"
              data-testid="rejected"
              data-tooltip="expand"
            />
          </div>
          <div
            class="clientConnectionMetric"
          >
            <span>
              Aborted Clients
            </span>
            <label
              class="msg label"
              data-testid="abortedClients"
              data-tooltip="expand"
            />
          </div>
          <div
            class="clientConnectionMetric"
          >
            <span>
              Aborted Connections
            </span>
            <label
              class="msg label"
              data-testid="abortedConnections"
              data-tooltip="expand"
            />
          </div>
          <div
            class="clientConnectionMetric"
          >
            <span>
              Errors
            </span>
            <label
              class="msg label"
              data-testid="errors"
              data-tooltip="expand"
            />
          </div>
        </div>
      </section>
      <div
        class="msg splitContainer resizing"
        id="connectionList"
      >
        <div
          class="sashContainer"
        >
          <div
            class="msg divider vertical sash"
            id="connectionGridSash"
            style="--thickness: 16px; left: 317px;"
          />
        </div>
        <div
          class="splitContentContainer"
        >
          <div
            class="msg container fixedScrollbar splitHost stretch"
            id="connectionGridHost"
            style="flex-direction: row; justify-content: stretch; width: 320px; left: 0px;"
          >
            <div
              id="connectionListContent"
            >
              <div
                class="msg container fixedScrollbar toolbar verticalCenterContent"
                id="clientConnectionToolbar"
                style="flex-direction: row; align-items: center;"
              >
                <label
                  class="msg label"
                  data-tooltip="expand"
                  style="margin-left: 8px;"
                >
                  Refresh Rate:
                </label>
                <div
                  class="msg container fixedScrollbar dropdown"
                  data-tooltip="inherit"
                  id="refreshSelector"
                  style="flex-direction: row; align-items: center;"
                  tabindex="0"
                >
                  <label
                    class="msg label ellipsis"
                    data-tooltip="inherit"
                  >
                    5 seconds
                  </label>
                </div>
                <div
                  class="msg button imageOnly"
                  data-tooltip="Refresh"
                  role="button"
                  tabindex="0"
                >
                  <div
                    class="msg icon"
                    data-tooltip="inherit"
                    style="mask-image: url("data:image/svg+xml,%3c?xml%20version='1.0'%20encoding='UTF-8'%20standalone='no'?%3e%3c!DOCTYPE%20svg%20PUBLIC%20'-//W3C//DTD%20SVG%201.1//EN'%20'http://www.w3.org/Graphics/SVG/1.1/DTD/svg11.dtd'%3e%3csvg%20width='100%25'%20height='100%25'%20viewBox='0%200%2024%2020'%20version='1.1'%20xmlns='http://www.w3.org/2000/svg'%20xmlns:xlink='http://www.w3.org/1999/xlink'%20xml:space='preserve'%20xmlns:serif='http://www.serif.com/'%20style='fill-rule:evenodd;clip-rule:evenodd;stroke-linejoin:round;stroke-miterlimit:2;'%3e%3cg%20transform='matrix(1,0,0,1,-306,-161)'%3e%3cg%20id='refresh'%20transform='matrix(1,0,0,1,309.561,163.025)'%3e%3cpath%20d='M4.681,3L2,3L2,2L5.5,2L6,2.5L6,6L5,6L5,4C3.742,4.944%203.001,6.427%203.001,7.999C3.001,10.742%205.258,12.999%208.001,12.999C10.744,12.999%2013.001,10.742%2013.001,7.999C13.001,5.833%2011.593,3.902%209.53,3.239L9.832,2.285C12.309,3.079%2014,5.398%2014,7.998C14,11.29%2011.291,13.998%208,13.998C4.708,13.998%202,11.29%202,7.998C2,5.99%203.008,4.111%204.681,3Z'/%3e%3c/g%3e%3c/g%3e%3c/svg%3e");"
                  />
                </div>
                <div
                  class="expander"
                />
                <div
                  class="msg button imageOnly"
                  data-tooltip="Display Options"
                  role="button"
                  tabindex="0"
                >
                  <div
                    class="msg icon"
                    data-tooltip="inherit"
                    style="mask-image: url("/src/assets/images/settings.svg");"
                  />
                </div>
              </div>
              <div
                id="connectionGridFrame"
              />
            </div>
          </div>
          <div
            class="msg container fixedScrollbar splitHost"
            id="connectionDetailsHost"
            style="flex-direction: row; justify-content: stretch; width: 430px; left: 320px;"
          >
            <div
              class="msg container fixedScrollbar"
              id="connectionDetails"
              style="flex-direction: column;"
            >
              <div
                class="connectionDetailsSummary"
              >
                <div
                  class="connectionDetailsNavigation"
                >
                  <div
                    class="msg button imageOnly disabled clientConnectionHistoryButton"
                    data-direction="back"
                    data-tooltip="Back"
                    role="button"
                    tabindex="0"
                  >
                    <div
                      class="msg icon codicon codicon-arrow-left"
                      data-tooltip="inherit"
                    />
                  </div>
                  <div
                    class="msg button imageOnly disabled clientConnectionHistoryButton"
                    data-direction="next"
                    data-tooltip="Next"
                    role="button"
                    tabindex="0"
                  >
                    <div
                      class="msg icon codicon codicon-arrow-right"
                      data-tooltip="inherit"
                    />
                  </div>
                </div>
                <span
                  class="connectionDetailsCaption"
                >
                  CONNECTION_ID
                </span>
                <div
                  class="connectionDetailsIdentity"
                >
                  <span
                    class="connectionDetailsProcessId"
                  >
                    <input
                      aria-label="Connection ID"
                      class="connectionDetailsProcessIdInput"
                      disabled=""
                    />
                  </span>
                  <div
                    class="connectionDetailsActions"
                  >
                    <div
                      class="msg button imageOnly disabled clientConnectionKillButton"
                      data-tooltip="Kill Query"
                      role="button"
                      tabindex="0"
                    >
                      <div
                        class="msg icon codicon codicon-debug-stop"
                        data-tooltip="inherit"
                      />
                    </div>
                    <div
                      class="msg button imageOnly disabled clientConnectionKillButton"
                      data-tooltip="Kill Connection"
                      role="button"
                      tabindex="0"
                    >
                      <div
                        class="msg icon codicon codicon-debug-disconnect"
                        data-tooltip="inherit"
                      />
                    </div>
                    <div
                      class="msg divider vertical"
                      style="--thickness: 1px;"
                    />
                    <div
                      class="msg button imageOnly clientConnectionShowDetailsButton"
                      data-tooltip="Show Details"
                      role="button"
                      tabindex="0"
                    >
                      <div
                        class="msg icon"
                        data-tooltip="inherit"
                        style="mask-image: url("data:image/svg+xml,%3c?xml%20version='1.0'%20encoding='UTF-8'%20standalone='no'?%3e%3c!DOCTYPE%20svg%20PUBLIC%20'-//W3C//DTD%20SVG%201.1//EN'%20'http://www.w3.org/Graphics/SVG/1.1/DTD/svg11.dtd'%3e%3csvg%20width='100%25'%20height='100%25'%20viewBox='0%200%2024%2020'%20version='1.1'%20xmlns='http://www.w3.org/2000/svg'%20xmlns:xlink='http://www.w3.org/1999/xlink'%20xml:space='preserve'%20xmlns:serif='http://www.serif.com/'%20style='fill-rule:evenodd;clip-rule:evenodd;stroke-linejoin:round;stroke-miterlimit:2;'%3e%3cg%20transform='matrix(1,0,0,1,-450,-128)'%3e%3cg%20id='Infos'%20transform='matrix(1,0,0,1,-2,0)'%3e%3cg%20transform='matrix(1.13501,0,0,1.13501,-61.4294,-17.5513)'%3e%3cpath%20d='M462.5,130C466.639,130%20470,133.361%20470,137.5C470,141.639%20466.639,145%20462.5,145C458.361,145%20455,141.639%20455,137.5C455,133.361%20458.361,130%20462.5,130ZM462.5,131.226C465.963,131.226%20468.774,134.037%20468.774,137.5C468.774,140.963%20465.963,143.774%20462.5,143.774C459.037,143.774%20456.226,140.963%20456.226,137.5C456.226,134.037%20459.037,131.226%20462.5,131.226Z'%20style='fill:rgb(34,34,36);'/%3e%3c/g%3e%3cg%20transform='matrix(1.94821,0,0,1.11574,-477.155,-9.48829)'%3e%3cpath%20d='M483.457,131.163C483.453,131.311%20483.447,131.522%20483.439,131.795C483.388,133.366%20483.363,134.471%20483.363,135.112L483.363,135.733C483.363,136.186%20483.406,136.471%20483.492,136.588C483.578,136.706%20483.746,136.764%20483.996,136.764C484.019,136.764%20484.05,136.762%20484.089,136.758C484.128,136.754%20484.158,136.752%20484.177,136.752L484.177,137.151C483.845,137.127%20483.578,137.112%20483.375,137.104C483.171,137.096%20483,137.092%20482.859,137.092C482.734,137.092%20482.575,137.096%20482.381,137.104C482.188,137.112%20481.898,137.127%20481.511,137.151L481.511,136.741L481.658,136.741C482.142,136.741%20482.386,136.264%20482.39,135.311L482.39,134.989L482.414,133.542C482.414,133.436%20482.416,133.303%20482.419,133.143C482.423,132.983%20482.