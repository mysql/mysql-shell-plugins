                      />
                    </div>
                  </div>
                </div>
                <span>
                  No connection selected
                </span>
              </div>
              <div
                class="connectionDetailsEmpty"
                id="clientConnectionDetails"
              >
                Select a connection to show details.
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
`;
