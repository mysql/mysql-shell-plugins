def _mysqlbackup_apply_log_plan_for_backup(backup_dir: Path, config: HelperConfig) -> ProcessPlan:
    variables = _read_backup_variables(backup_dir)
    if variables.get("apply_log_done") == "1":
        raise HelperError("invalid_request", "apply-log is not pending for this backup.")
    plan = _mysqlbackup_validate_plan_for_backup(backup_dir, config)
    args = [f"--backup-dir={backup_dir.as_posix()}"]
    if variables.get("is_compressed") == "1":
        args.append("--uncompress")
    args.append("apply-log")
    return replace(plan, args=args, audit_name="backups.applyLog")


def _read_backup_variables(backup_dir: Path) -> dict[str, str]:
    variables_path = backup_dir / "meta" / "backup_variables.txt"
    try:
        file_stat = variables_path.lstat()
    except OSError:
        raise HelperError("invalid_request", "backup metadata was not found.")

    if not stat.S_ISREG(file_stat.st_mode):
        raise HelperError("invalid_request", "backup metadata must be a regular file.")

    parser = configparser.RawConfigParser()
    try:
        with variables_path.open("r", encoding="utf-8") as variables_file:
            parser.read_file(variables_file)
    except (OSError, configparser.Error):
        raise HelperError("invalid_request", "backup metadata could not be read.")

    if not parser.has_section("backup_variables"):
        raise HelperError("invalid_request", "backup metadata is malformed.")

    return dict(parser.items("backup_variables"))


def _read_restore_base_defaults(backup_dir: Path, datadir: str) -> str:
    defaults_path = backup_dir / "backup-my.cnf"
    try:
        file_stat = defaults_path.lstat()
    except OSError:
        return f"[mysqld]\ndatadir = {datadir}\n"

    if not stat.S_ISREG(file_stat.st_mode):
        raise HelperError("invalid_request", "backup defaults file must be a regular file.")

    try:
        content = defaults_path.read_text(encoding="utf-8")
    except OSError:
        raise HelperError("invalid_request", "backup defaults file could not be read.")

    return f"{content.rstrip()}\n\ndatadir = {datadir}\n"


def _write_restore_defaults_file(backup_dir: Path, datadir: str) -> Path:
    fd = None
    temp_name = None
    completed = False
    try:
        fd, temp_name = tempfile.mkstemp(prefix=".restore-", suffix=".cnf", dir=backup_dir, text=True)
        if os.name == "posix":
            os.chmod(temp_name, JOB_STORE_MODE)

        with os.fdopen(fd, "w", encoding="utf-8") as defaults_file:
            fd = None
            defaults_file.write(_read_restore_base_defaults(backup_dir, datadir))
            defaults_file.flush()
            os.fsync(defaults_file.fileno())

        completed = True
        return Path(temp_name)
    except OSError:
        raise HelperError("operation_failed", "restore defaults file could not be written.")
    finally:
        if fd is not None:
            os.close(fd)
        if temp_name is not None and not completed:
            try:
                os.unlink(temp_name)
            except FileNotFoundError:
                pass


def _delete_restore_defaults_file(path: Path) -> None:
    try:
        path.unlink()
    except FileNotFoundError:
        return
    except OSError:
        raise HelperError("operation_failed", "restore defaults file could not be deleted.")


def _mysqlbackup_restore_plan_for_backup(
    backup_dir: Path,
    defaults_file: Path,
    config: HelperConfig,
    *,
    force: bool,
) -> ProcessPlan:
    if not config.datadir:
        raise HelperError("invalid_config", "datadir is required for restore.")

    target_user = resolve_target_user(config)
    variables = _read_backup_variables(backup_dir)
    is_incremental = variables.get("is_incremental") == "1"
    is_compressed = variables.get("is_compressed") == "1"
    apply_log_done = variables.get("apply_log_done") == "1"
    env = {
        "PATH": r"C:\Windows\System32",
        "SYSTEMROOT": os.environ.get("SystemRoot", r"C:\Windows"),
        "MYSQL_TEST_LOGIN_FILE": config.login_file,
    } if os.name == "nt" else {
        "LANG": "C",
        "LC_ALL": "C",
        "PATH": "/usr/bin:/bin",
        "MYSQL_TEST_LOGIN_FILE": config.login_file,
    }
    args = [
        f"--defaults-file={defaults_file.as_posix()}",
        f"--login-path={config.login_path}",
        f"--backup-dir={backup_dir.as_posix()}",
    ]
    if force:
        args.append("--force")
    if is_incremental:
        args.append("--incremental")
    if is_compressed:
        args.append("--uncompress")
    args.append("copy-back" if not is_incremental and apply_log_done else "copy-back-and-apply-log")

    return ProcessPlan(
        executable=config.mysqlbackup,
        args=args,
        cwd=config.working_directory,
        env=env,
        uid=target_user.uid,
        gid=target_user.gid,
        timeout_ms=config.timeout_ms,
        max_output_bytes=config.max_output_bytes,
        audit_name="backups.restore",
        account=target_user.account,
    )


def _public_jobs(jobs: dict[str, dict[str, Any]]) -> list[dict[str, Any]]:
    return [jobs[job_id] for job_id in sorted(jobs)]


def _cron_values(field: str, minimum: int, maximum: int) -> set[int]:
    values = _expand_cron_field(field, minimum, maximum)
    if values is None:
        return set(range(minimum, maximum + 1))

    return set(values)


def _cron_day_of_week_values(field: str) -> set[int]:
    return {0 if value == 7 else value for value in _cron_values(field, 0, 7)}


def _schedules_overlap(first: dict[str, str], second: dict[str, str]) -> bool:
    return (
        bool(_cron_values(first["minute"], 0, 59) & _cron_values(second["minute"], 0, 59))
        and bool(_cron_values(first["hour"], 0, 23) & _cron_values(second["hour"], 0, 23))
        and bool(_cron_values(first["dayOfMonth"], 1, 31) & _cron_values(second["dayOfMonth"], 1, 31))
        and bool(_cron_values(first["month"], 1, 12) & _cron_values(second["month"], 1, 12))
        and bool(_cron_day_of_week_values(first["dayOfWeek"]) & _cron_day_of_week_values(second["dayOfWeek"]))
    )


def _validate_non_overlapping_job_schedules(jobs: dict[str, dict[str, Any]]) -> None:
    seen: list[tuple[str, dict[str, str]]] = []
    for job_id, job in jobs.items():
        schedule = job.get("schedule")
        if not isinstance(schedule, dict):
            continue
        for existing_id, existing_schedule in seen:
            if _schedules_overlap(schedule, existing_schedule):
                raise HelperError("invalid_request", f"jobs '{existing_id}' and '{job_id}' use overlapping schedules.")
        seen.append((job_id, schedule))


def _process_exists(pid: int) -> bool:
    if pid < 1:
        return False
    if os.name == "nt":
        return _windows_process_exists(pid)

    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True


def _windows_process_exists(pid: int) -> bool:
    import ctypes
    from ctypes import wintypes

    process_query_limited_information = 0x1000
    still_active = 259
    error_invalid_parameter = 87
    kernel32 = ctypes.WinDLL("kernel32", use_last_error=True)
    kernel32.OpenProcess.argtypes = [wintypes.DWORD, wintypes.BOOL, wintypes.DWORD]
    kernel32.OpenProcess.restype = wintypes.HANDLE
    kernel32.GetExitCodeProcess.argtypes = [wintypes.HANDLE, ctypes.POINTER(wintypes.DWORD)]
    kernel32.GetExitCodeProcess.restype = wintypes.BOOL
    kernel32.CloseHandle.argtypes = [wintypes.HANDLE]
    kernel32.CloseHandle.restype = wintypes.BOOL

    process = kernel32.OpenProcess(process_query_limited_information, False, pid)
    if not process:
        error = ctypes.get_last_error()
        if error == error_invalid_parameter:
            return False

        return True

    try:
        exit_code = wintypes.DWORD()
        if not kernel32.GetExitCodeProcess(process, ctypes.byref(exit_code)):
            return True

        return exit_code.value == still_active
    finally:
        kernel32.CloseHandle(process)


def _read_run_lock_owner(lock_dir: Path) -> dict[str, Any] | None:
    owner_path = lock_dir / RUN_LOCK_OWNER_NAME
    try:
        with owner_path.open("r", encoding="utf-8") as owner_file:
            return require_dict(json.load(owner_file), "run lock owner")
    except (OSError, json.JSONDecodeError, HelperError):
        return None


def _run_lock_owner_is_complete(owner: dict[str, Any] | None) -> bool:
    if owner is None:
        return False

    return (
        owner.get("version") == 1
        and isinstance(owner.get("host"), str)
        and isinstance(owner.get("pid"), int)
        and not isinstance(owner.get("pid"), bool)
        and isinstance(owner.get("token"), str)
        and bool(owner.get("token"))
    )


def _write_run_lock_owner(lock_dir: Path, owner: dict[str, Any]) -> None:
    owner_path = lock_dir / RUN_LOCK_OWNER_NAME
    fd = None
    try:
        flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL
        if hasattr(os, "O_CLOEXEC"):
            flags |= os.O_CLOEXEC
        if hasattr(os, "O_NOFOLLOW"):
            flags |= os.O_NOFOLLOW
        fd = os.open(owner_path, flags, JOB_STORE_MODE)
        if os.name == "posix":
            os.fchmod(fd, JOB_STORE_MODE)
        payload = json.dumps(owner, indent=2, sort_keys=True).encode("utf-8")
        os.write(fd, payload)
        os.write(fd, b"\n")
        os.fsync(fd)
    except OSError:
        raise HelperError("operation_failed", "run lock owner could not be written.")
    finally:
        if fd is not None:
            os.close(fd)


def _lock_is_stale(lock_dir: Path) -> bool:
    owner = _read_run_lock_owner(lock_dir)
    if owner is None:
        return False

    host = owner.get("host")
    pid = owner.get("pid")
    if host != socket.gethostname() or not isinstance(pid, int):
        return False

    return not _process_exists(pid)


def _lock_entry_is_abandoned(path: Path) -> bool:
    try:
        file_stat = path.lstat()
    except OSError:
        return False

    return time.time() - file_stat.st_mtime >= RUN_LOCK_INITIALIZATION_GRACE_SECONDS


def _break_incomplete_run_lock(lock_dir: Path) -> bool:
    try:
        lock_stat = lock_dir.lstat()
    except OSError:
        return False
    if not stat.S_ISDIR(lock_stat.st_mode) or not _lock_entry_is_abandoned(lock_dir):
        return False

    owner_path = lock_dir / RUN_LOCK_OWNER_NAME
    owner_stat = None
    try:
        owner_stat = owner_path.lstat()
    except FileNotFoundError:
        pass
    except OSError:
        return False
    if owner_stat is not None:
        if not stat.S_ISREG(owner_stat.st_mode) or not _lock_entry_is_abandoned(owner_path):
            return False

    if _run_lock_owner_is_complete(_read_run_lock_owner(lock_dir)):
        return False

    try:
        latest_lock_stat = lock_dir.lstat()
        if (latest_lock_stat.st_dev, latest_lock_stat.st_ino) != (lock_stat.st_dev, lock_stat.st_ino):
            return False
        if owner_stat is not None:
            latest_owner_stat = owner_path.lstat()
            if (latest_owner_stat.st_dev, latest_owner_stat.st_ino) != (owner_stat.st_dev, owner_stat.st_ino):
                return False
            owner_path.unlink()
        lock_dir.rmdir()
        return True
    except OSError:
        return False


def _break_stale_run_lock(lock_dir: Path) -> bool:
    owner = _read_run_lock_owner(lock_dir)
    if not _run_lock_owner_is_complete(owner):
        return _break_incomplete_run_lock(lock_dir)
    assert owner is not None
    token = owner.get("token")
    if not token or not _lock_is_stale(lock_dir):
        return False

    latest_owner = _read_run_lock_owner(lock_dir)
    if latest_owner is None or latest_owner.get("token") != token:
        return False

    try:
        (lock_dir / RUN_LOCK_OWNER_NAME).unlink()
        lock_dir.rmdir()
        return True
    except OSError:
        return False


class BackupRunLock:
    def __init__(
        self,
        backup_home: Path,
        job_id: str,
        run_mode: str,
        operation_id: str | None = None,
    ) -> None:
        self.lock_dir = _run_lock_path(backup_home)
        self.job_id = job_id
        self.run_mode = run_mode
        self.operation_id = operation_id
        self.token = hashlib.sha256(f"{socket.gethostname()}:{os.getpid()}:{time.time_ns()}:{job_id}".encode("utf-8")).hexdigest()
        self.acquired = False

    def try_acquire(self) -> bool:
        while True:
            created_lock_stat = None
            try:
                os.mkdir(self.lock_dir, 0o700)
                created_lock_stat = self.lock_dir.lstat()
                if os.name == "posix":
                    os.chmod(self.lock_dir, 0o700)
                owner = {
                    "version": 1,
                    "host": socket.gethostname(),
                    "pid": os.getpid(),
                    "jobId": self.job_id,
                    "runMode": self.run_mode,
                    "startedTime": int(time.time()),
                    "token": self.token,
                }
                if self.operation_id is not None:
                    owner["operationId"] = self.operation_id
                _write_run_lock_owner(self.lock_dir, owner)
                self.acquired = True
                return True
            except FileExistsError:
                if _break_stale_run_lock(self.lock_dir):
                    continue
                return False
            except HelperError:
                if created_lock_stat is not None:
                    self._remove_failed_acquisition(created_lock_stat)
                raise
            except OSError:
                if created_lock_stat is not None:
                    self._remove_failed_acquisition(created_lock_stat)
                raise HelperError("operation_failed", "run lock could not be acquired.")

    def _remove_failed_acquisition(self, created_lock_stat: os.stat_result) -> None:
        try:
            current_stat = self.lock_dir.lstat()
            if (current_stat.st_dev, current_stat.st_ino) != (created_lock_stat.st_dev, created_lock_stat.st_ino):
                return
            owner = _read_run_lock_owner(self.lock_dir)
            if owner is not None and owner.get("token") != self.token:
                return
            owner_path = self.lock_dir / RUN_LOCK_OWNER_NAME
            if owner_path.exists():
                owner_path.unlink()
            self.lock_dir.rmdir()
        except OSError:
            pass

    def wait_acquire(self) -> None:
        while not self.try_acquire():
            time.sleep(RUN_LOCK_POLL_SECONDS)

    def release(self) -> None:
        if not self.acquired:
            return

        owner = _read_run_lock_owner(self.lock_dir)
        if owner is not None and owner.get("token") == self.token:
            try:
                (self.lock_dir / RUN_LOCK_OWNER_NAME).unlink()
                self.lock_dir.rmdir()
            except OSError:
                pass
        self.acquired = False

    def __enter__(self) -> "BackupRunLock":
        return self

    def __exit__(self, _exc_type: Any, _exc: Any, _tb: Any) -> None:
        self.release()


