def handle_jobs_execute(params: Any, config: HelperConfig, dry_run: bool) -> Any:
    request = require_dict(params, "jobs.execute params")
    reject_unknown_fields(request, {"backupHome", "jobId", "runMode"}, "jobs.execute params")

    user = _current_user()
    backup_home = _require_valid_backup_home(Path(require_string(request.get("backupHome"), "backupHome")), config, user, write=True)
    job_id = require_safe_identifier(request.get("jobId"), "jobId")
    run_mode = request.get("runMode", "manual")
    if run_mode not in {"manual", "scheduled"}:
        raise HelperError("invalid_request", "runMode is not supported.")
    jobs = _derived_profile_jobs(backup_home, config)
    job = jobs.get(job_id)
    if job is None:
        raise HelperError("invalid_request", "jobId is not defined.")

    job = _require_job_definition(job, config, resolve_target_user(config))
    plan = _mysqlbackup_plan_for_job(job, config)
    mysqlbackup_progress_path = _mysqlbackup_progress_path(backup_home)
    plan = _with_mysqlbackup_progress_file(plan, mysqlbackup_progress_path)

    if dry_run:
        return {
            "job": job,
            "runMode": run_mode,
            "plan": redact_plan(plan),
        }

    start_time = int(time.time())
    log_path = _new_job_log_path(backup_home, job_id, user).as_posix()
    _prepare_mysqlbackup_progress_file(mysqlbackup_progress_path)
    plan = replace(
        plan,
        log_path=log_path,
        progress_path=_progress_state_path(backup_home).as_posix(),
        progress_context={
            "jobId": job_id,
            "backupMode": job["backupMode"],
            "runMode": run_mode,
            "startedTime": start_time,
            "logPath": log_path,
            "mysqlbackupProgressPath": mysqlbackup_progress_path.as_posix(),
        },
    )
    run_lock = BackupRunLock(backup_home, job_id, str(run_mode))
    if run_mode == "manual" and not run_lock.try_acquire():
        raise HelperError("backup_running", "Another backup is already running.")
    if run_mode == "scheduled":
        run_lock.wait_acquire()

    with run_lock:
        result = run_process_plan(plan)

        return {
            "status": "completed",
            **process_status(result),
        }


