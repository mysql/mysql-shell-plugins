def _unlink_private_file(path: Path, user: dict[str, Any], label: str) -> bool:
    try:
        file_stat = path.lstat()
    except FileNotFoundError:
        return False
    except OSError:
        raise HelperError("operation_failed", f"{label} could not be checked.")

    if not stat.S_ISREG(file_stat.st_mode):
        raise HelperError("invalid_request", f"{label} must be a regular file, not a symlink or directory.")
    _require_private_regular_file(file_stat, user, label)

    try:
        path.unlink()
    except FileNotFoundError:
        return False
    except OSError:
        raise HelperError("operation_failed", f"{label} could not be deleted.")

    return True


def _backup_delete_related_progress_files(
    backup_home: Path,
    config: HelperConfig,
    user: dict[str, Any],
    log_path: Path | None,
) -> list[str]:
    if log_path is None:
        return []

    progress_path = _progress_state_path(backup_home)
    try:
        progress_state = _read_json_store(progress_path, config, user, missing_ok=True, label="progress")
    except HelperError:
        return []

    if progress_state.get("logPath") != log_path.as_posix() or progress_state.get("state") == "running":
        return []

    deleted = []
    if _unlink_private_file(progress_path, user, "progress file"):
        deleted.append(progress_path.as_posix())

    mysqlbackup_progress_path = _mysqlbackup_progress_path(backup_home)
    if progress_state.get("mysqlbackupProgressPath") == mysqlbackup_progress_path.as_posix():
        if _unlink_private_file(mysqlbackup_progress_path, user, "mysqlbackup progress file"):
            deleted.append(mysqlbackup_progress_path.as_posix())

    return deleted


def handle_backups_delete(params: Any, config: HelperConfig, dry_run: bool) -> Any:
    request = require_dict(params, "backups.delete params")
    reject_unknown_fields(request, {"backupHome", "backupId", "logId"}, "backups.delete params")

    user = _current_user()
    backup_home = _require_valid_backup_home(Path(require_string(request.get("backupHome"), "backupHome")), config, user, write=True)
    log_id = request.get("logId")
    if request.get("backupId") is None:
        if log_id is None:
            raise HelperError("invalid_request", "backupId or logId is required.")
        log_id = _require_log_id(log_id)
        log_path, _log_stat = _log_path(backup_home, log_id, user)
        if not dry_run:
            _unlink_private_file(log_path, user, "log file")

        return {
            "status": "wouldDelete" if dry_run else "deleted",
            "backupHome": backup_home.as_posix(),
            "logId": log_id,
            "logPath": log_path.as_posix(),
        }

    relative_path = _require_safe_relative_path(request.get("backupId"), "backupId")
    target_path, file_stat = _require_backup_child_path(backup_home, relative_path, "backupId")
    if not stat.S_ISDIR(file_stat.st_mode):
        raise HelperError("invalid_request", "backupId must name a backup directory.")

    log_path = None
    if log_id is not None:
        log_path, _log_stat = _log_path(backup_home, _require_log_id(log_id), user)

    deleted_related: list[str] = []
    if not dry_run:
        try:
            shutil.rmtree(target_path)
        except OSError:
            raise HelperError("operation_failed", "backup directory could not be deleted.")
        if log_path is not None and _unlink_private_file(log_path, user, "log file"):
            deleted_related.append(log_path.as_posix())
        deleted_related.extend(_backup_delete_related_progress_files(backup_home, config, user, log_path))

    return {
        "status": "wouldDelete" if dry_run else "deleted",
        "backupHome": backup_home.as_posix(),
        "backupId": relative_path.as_posix(),
        "path": target_path.as_posix(),
        "deletedRelated": deleted_related,
    }


def handle_backups_verify(params: Any, config: HelperConfig, dry_run: bool) -> Any:
    request = require_dict(params, "backups.verify params")
    reject_unknown_fields(request, {"backupHome", "backupId"}, "backups.verify params")

    user = _current_user()
    backup_home = _require_valid_backup_home(
        Path(require_string(request.get("backupHome"), "backupHome")), config, user, write=False,
    )
    relative_path = _require_safe_relative_path(request.get("backupId"), "backupId")
    target_path, file_stat = _require_backup_child_path(backup_home, relative_path, "backupId")
    if not stat.S_ISDIR(file_stat.st_mode):
        raise HelperError("invalid_request", "backupId must name a backup directory.")

    plan = _mysqlbackup_validate_plan_for_backup(target_path, config)
    if dry_run:
        return {
            "backupHome": backup_home.as_posix(),
            "backupId": relative_path.as_posix(),
            "path": target_path.as_posix(),
            "plan": redact_plan(plan),
        }

    result = run_process_plan(plan)

    status = "failed" if result["exitCode"] != 0 or result["timedOut"] else "verified"
    output = str(result.get("output") or "")
    if not output:
        output = "\n\n".join(
            stream.rstrip() for stream in (str(result.get("stdout") or ""), str(result.get("stderr") or ""))
            if stream.strip()
        )
    if not output:
        output = "Backup verification completed successfully." if status == "verified" else "Backup verification failed."

    return {
        "status": status,
        "backupHome": backup_home.as_posix(),
        "backupId": relative_path.as_posix(),
        "path": target_path.as_posix(),
        "output": output,
        **process_status(result),
    }


