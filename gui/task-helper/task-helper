def _request_backup_home(value: Any) -> Path:
    backup_home = Path(require_string(value, "backupHome"))
    if not backup_home.is_absolute():
        raise HelperError("invalid_request", "backupHome must be an absolute path.")
    try:
        return backup_home.resolve(strict=True)
    except OSError:
        raise HelperError("invalid_request", "backupHome does not exist.")


def _validate_operation_backup_home(params: Any, config: HelperConfig) -> None:
    if not config.backup_home or not isinstance(params, dict) or params.get("backupHome") is None:
        return

    operation_backup_home = _request_backup_home(params["backupHome"])
    if operation_backup_home.as_posix() != config.backup_home:
        raise HelperError("invalid_request", "operation backupHome does not match the selected backupHome.")


def handle_request(request_value: Any, config: HelperConfig | None = None, allow_dry_run: bool = False) -> dict[str, Any]:
    request_id = None
    operation = None

    try:
        request = require_dict(request_value, "request")
        reject_unknown_fields(request, {"id", "version", "operation", "params", "dryRun", "backupHome"}, "request")
        if isinstance(request.get("id"), str):
            request_id = request["id"]

        if request.get("version") is not None and request.get("version") != 1:
            raise HelperError("invalid_request", "request.version is not supported.")

        if request.get("dryRun") is not None and not allow_dry_run:
            raise HelperError("invalid_request", "request.dryRun is not accepted by the helper service.")

        operation = require_string(request.get("operation"), "operation")
        handler = HANDLERS.get(operation)
        if handler is None:
            raise HelperError("unknown_operation", f"operation '{operation}' is not registered.")
        if config is None:
            config = helper_config(_request_backup_home(request.get("backupHome")))
        elif request.get("backupHome") is not None:
            selected_backup_home = _request_backup_home(request["backupHome"])
            if config.backup_home and selected_backup_home.as_posix() != config.backup_home:
                raise HelperError("invalid_request", "request backupHome does not match the loaded configuration.")

        _validate_operation_backup_home(request.get("params"), config)

        result = handler(request.get("params"), config, request.get("dryRun") is True)

        return {
            "id": request_id,
            "ok": True,
            "operation": operation,
            "result": result,
        }
    except HelperError as error:
        return {
            "id": request_id,
            "ok": False,
            "operation": operation,
            "error": {
                "code": error.code,
                "message": error.message,
            },
        }
    except Exception:
        return {
            "id": request_id,
            "ok": False,
            "operation": operation,
            "error": {
                "code": "internal_error",
                "message": "Internal helper error.",
            },
        }

