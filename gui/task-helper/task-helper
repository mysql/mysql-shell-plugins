def _current_user() -> dict[str, Any]:
    if os.name != "posix":
        return {
            "uid": None,
            "gid": None,
            "name": os.environ.get("USERNAME") or os.environ.get("USER"),
        }

    uid = os.geteuid()
    try:
        name = pwd.getpwuid(uid).pw_name
    except KeyError:
        name = None

    return {"uid": uid, "gid": os.getegid(), "name": name}


def _check(check_id: str, status: str, expected: str, observed: str, message: str) -> dict[str, str]:
    return {
        "id": check_id,
        "status": status,
        "expected": expected,
        "observed": observed,
        "message": message,
    }


def _action(action_id: str, status: str, before: str, after: str, message: str) -> dict[str, str]:
    return {
        "id": action_id,
        "status": status,
        "before": before,
        "after": after,
        "message": message,
    }


def _summary(checks: list[dict[str, str]]) -> dict[str, int]:
    return {
        "passed": sum(1 for check in checks if check["status"] == "pass"),
        "failed": sum(1 for check in checks if check["status"] == "fail"),
        "indeterminate": sum(1 for check in checks if check["status"] == "indeterminate"),
    }


def _validation_status(checks: list[dict[str, str]]) -> str:
    counts = _summary(checks)
    if counts["failed"]:
        return "invalid"
    if counts["indeterminate"]:
        return "indeterminate"

    return "valid"


def _validation_allows_operation(checks: list[dict[str, str]]) -> bool:
    return all(
        check["status"] == "pass"
        or (
            check["status"] == "indeterminate"
            and check["observed"] == "unsupported platform"
        )
        for check in checks
    )


def _file_type(file_stat: os.stat_result) -> str:
    if stat.S_ISLNK(file_stat.st_mode):
        return "symlink"
    if stat.S_ISDIR(file_stat.st_mode):
        return "directory"
    if stat.S_ISREG(file_stat.st_mode):
        return "regular file"

    return "special file"


def _mode(file_stat: os.stat_result) -> str:
    return f"{stat.S_IMODE(file_stat.st_mode):04o}"


def _path_check(
    check_id: str,
    path: Path,
    kind: str,
    *,
    missing_ok: bool = False,
) -> tuple[dict[str, str], os.stat_result | None]:
    expected = f"absolute {kind} path with no line breaks and no symlink"
    if missing_ok:
        expected = f"missing or {expected}"

    if not path.is_absolute():
        return _check(check_id, "fail", expected, "relative path", "Path must be absolute."), None

    if "\n" in path.as_posix() or "\r" in path.as_posix():
        return _check(check_id, "fail", expected, "contains line break", "Path must not contain line breaks."), None

    try:
        file_stat = path.lstat()
    except FileNotFoundError:
        if missing_ok:
            return _check(check_id, "pass", expected, "missing", "Path can be created."), None
        return _check(check_id, "fail", expected, "missing", "Path does not exist."), None
    except OSError as error:
        return _check(check_id, "fail", expected, error.__class__.__name__, "Path is not usable."), None

    observed = _file_type(file_stat)
    if observed == "symlink":
        return _check(check_id, "fail", expected, observed, "Path must not be a symlink."), None

    if observed != kind:
        return _check(check_id, "fail", expected, observed, f"Path must be a {kind}."), None

    return _check(check_id, "pass", expected, observed, f"Path is a usable {kind}."), file_stat


def _root_check(backup_home: Path, file_stat: os.stat_result | None, roots: list[str]) -> dict[str, str]:
    expected = "inside a configured backup root"
    if file_stat is None:
        return _check("backupHome.root", "indeterminate", expected, "path check failed", "Backup root was not checked.")

    try:
        candidate = backup_home.resolve(strict=True)
        allowed = [Path(root).resolve(strict=True) for root in roots]
    except OSError as error:
        return _check("backupHome.root", "fail", expected, error.__class__.__name__, "Backup root could not be resolved.")

    if any(candidate == root or root in candidate.parents for root in allowed):
        return _check("backupHome.root", "pass", expected, candidate.as_posix(), "Backup home is inside an allowed backup root.")

    return _check("backupHome.root", "fail", expected, candidate.as_posix(), "Backup home must be inside an allowed backup root.")


def _owner_check(check_id: str, file_stat: os.stat_result | None, user: dict[str, Any]) -> dict[str, str]:
    expected = "owned by the effective helper user"
    if file_stat is None:
        return _check(check_id, "indeterminate", expected, "path check failed", "Ownership was not checked.")
    if os.name != "posix":
        return _check(check_id, "indeterminate", expected, "unsupported platform", "Ownership validation is not available on this platform.")

    observed = f"uid={file_stat.st_uid} gid={file_stat.st_gid}"
    if file_stat.st_uid == user["uid"]:
        return _check(check_id, "pass", f"uid={user['uid']}", observed, "Owner is correct.")

    return _check(check_id, "fail", f"uid={user['uid']}", observed, "Owner must be the effective helper user.")


def _mode_check(check_id: str, file_stat: os.stat_result | None, mode: int) -> dict[str, str]:
    expected = f"{mode:04o}"
    if file_stat is None:
        return _check(check_id, "indeterminate", expected, "path check failed", "Permissions were not checked.")
    if os.name != "posix":
        return _check(check_id, "indeterminate", expected, "unsupported platform", "POSIX mode validation is not available on this platform.")

    observed = _mode(file_stat)
    status = "pass" if observed == expected else "fail"
    message = "Permissions are correct." if status == "pass" else f"Permissions must be {expected}."

    return _check(check_id, status, expected, observed, message)


def _access_check(check_id: str, path: Path, file_stat: os.stat_result | None, mask: int, label: str) -> dict[str, str]:
    if file_stat is None:
        return _check(check_id, "indeterminate", label, "path check failed", "Access was not checked.")

    try:
        ok = os.access(path, mask, effective_ids=True)
    except (NotImplementedError, TypeError):
        ok = os.access(path, mask)

    if ok:
        return _check(check_id, "pass", label, "available", "Access is available.")

    return _check(check_id, "fail", label, "not available", "Access is not available.")


def _read_backup_config(config_path: Path, file_stat: os.stat_result | None) -> tuple[dict[str, str], str | None, configparser.RawConfigParser | None]:
    if file_stat is None:
        return _check("config.parse", "indeterminate", "parseable config", "path check failed", "Config was not parsed."), None, None

    flags = os.O_RDONLY
    if hasattr(os, "O_CLOEXEC"):
        flags |= os.O_CLOEXEC
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW

    parser = configparser.RawConfigParser()
    parser.optionxform = str.lower # type: ignore
    fd = None

    try:
        fd = os.open(config_path, flags)
        opened_stat = os.fstat(fd)
        if os.name == "posix" and (opened_stat.st_dev != file_stat.st_dev or opened_stat.st_ino != file_stat.st_ino):
            os.close(fd)
            fd = None
            return _check("config.parse", "fail", "stable regular config file", "file changed while opening", "Config file changed while opening."), None, None
        if not stat.S_ISREG(opened_stat.st_mode):
            os.close(fd)
            fd = None
            return _check("config.parse", "fail", "stable regular config file", _file_type(opened_stat), "Config path did not open as a regular file."), None, None

        with os.fdopen(fd, "r", encoding="utf-8") as config_file:
            fd = None
            parser.read_file(config_file)
    except OSError as error:
        if fd is not None:
            os.close(fd)
        return _check("config.parse", "fail", "parseable config", error.__class__.__name__, "Config file could not be read."), None, None
    except configparser.Error as error:
        if fd is not None:
            os.close(fd)
        return _check("config.parse", "fail", "parseable config", error.__class__.__name__, "Config file could not be parsed."), None, None

    for section in ("meb", "meb_manager"):
        if parser.has_section(section):
            return _check("config.parse", "pass", "parseable config", f"[{section}]", "Config file was parsed."), section, parser

    return _check("config.parse", "fail", "parseable config with [meb] section", "section missing", "Config must contain a [meb] section."), None, None


def _datadir_match(config_datadir: str | None, data_dir: Path, data_dir_stat: os.stat_result | None) -> dict[str, str]:
    expected = data_dir.as_posix()
    if config_datadir is None:
        return _check("config.dataDir", "indeterminate", expected, "config datadir missing", "Config datadir was not checked.")
    if data_dir_stat is None:
        return _check("config.dataDir", "indeterminate", expected, "dataDir path check failed", "Config datadir was not checked.")
    if "\n" in config_datadir or "\r" in config_datadir:
        return _check("config.dataDir", "fail", expected, "contains line break", "Config datadir must not contain line breaks.")

    config_path = Path(config_datadir)
    if not config_path.is_absolute():
        return _check("config.dataDir", "fail", expected, "relative path", "Config datadir must be absolute.")

    try:
        expected = data_dir.resolve(strict=True).as_posix()
        observed = config_path.resolve(strict=True).as_posix()
    except OSError as error:
        return _check("config.dataDir", "fail", expected, error.__class__.__name__, "Config datadir could not be resolved.")

    if observed == expected:
        return _check("config.dataDir", "pass", expected, observed, "Config datadir matches the requested data directory.")

    return _check("config.dataDir", "fail", expected, observed, "Config datadir does not match the requested data directory.")


def _generated_config_values(
    backup_home: Path,
    data_dir: Path,
    config: HelperConfig,
    user: dict[str, Any],
) -> dict[str, str]:
    canonical_data_dir = data_dir.resolve(strict=True).as_posix()
    backup_home_path = backup_home.resolve(strict=True).as_posix()
    user_name = user["name"] if isinstance(user.get("name"), str) and user["name"] else str(user.get("uid") or "unknown")

    values = {
        "datadir": canonical_data_dir,
        "mysqlbackup": config.mysqlbackup,
        "backup_os_user": user_name,
        "login_file": (backup_home / ".mylogin.cnf").as_posix(),
        "login_path": f"mysql_workbench_meb_{hashlib.sha256(canonical_data_dir.encode('utf-8')).hexdigest()[:12]}",
        "crontab": config.crontab,
        "job_runner": config.job_runner,
        "backup_root": config.backup_roots[0] if config.backup_roots else backup_home_path,
        "option_file_root": config.option_file_roots[0] if config.option_file_roots else backup_home_path,
        "working_directory": config.working_directory,
        "timeout_ms": str(config.timeout_ms),
        "max_output_bytes": str(config.max_output_bytes),
        "launchctl": config.launchctl,
        "schtasks": config.schtasks,
        "scheduler_backend": config.scheduler_backend,
        "launchd_plist_dir": config.launchd_plist_dir,
        "windows_task_folder": config.windows_task_folder,
    }
    if user.get("uid") is not None and user.get("gid") is not None:
        values["backup_os_uid"] = str(user["uid"])
        values["backup_os_gid"] = str(user["gid"])
    if config.target_user.windows_logon_type:
        values["windows_logon_type"] = config.target_user.windows_logon_type

    return values


def _write_config_file(config_path: Path, values: dict[str, str]) -> None:
    parser = configparser.RawConfigParser()
    parser.add_section("meb")
    for key, value in values.items():
        parser.set("meb", key, value)

    stream = io.StringIO()
    stream.write("# MySQL Enterprise Backup local support configuration\n")
    parser.write(stream)

    fd = None
    temp_name = None
    try:
        fd, temp_name = tempfile.mkstemp(prefix=f".{CONFIG_NAME}.", suffix=".tmp", dir=config_path.parent, text=True)
        if os.name == "posix":
            os.chmod(temp_name, CONFIG_MODE)

        with os.fdopen(fd, "w", encoding="utf-8") as config_file:
            fd = None
            config_file.write(stream.getvalue())
            config_file.flush()
            os.fsync(config_file.fileno())

        os.replace(temp_name, config_path)
        temp_name = None
        if os.name == "posix":
            try:
                os.chmod(config_path, CONFIG_MODE, follow_symlinks=False)
            except NotImplementedError:
                os.chmod(config_path, CONFIG_MODE)
            directory_fd = os.open(config_path.parent, os.O_RDONLY)
            try:
                os.fsync(directory_fd)
            finally:
                os.close(directory_fd)
    finally:
        if fd is not None:
            os.close(fd)
        if temp_name is not None:
            try:
                os.unlink(temp_name)
            except FileNotFoundError:
                pass


def _base_response(status: str, backup_home: Path, config_path: Path, user: dict[str, Any], checks: list[dict[str, str]]) -> dict[str, Any]:
    return {
        "status": status,
        "backupHome": backup_home.as_posix(),
        "configPath": config_path.as_posix(),
        "effectiveUser": user,
        "checks": checks,
        "summary": _summary(checks),
    }


def _backup_home_checks(backup_home: Path, config: HelperConfig, user: dict[str, Any], write: bool) -> tuple[list[dict[str, str]], os.stat_result | None]:
    checks = []
    path_check, file_stat = _path_check("backupHome.path", backup_home, "directory")
    checks.append(path_check)
    checks.append(_root_check(backup_home, file_stat, config.backup_roots))
    checks.append(_owner_check("backupHome.owner", file_stat, user))
    checks.append(_mode_check("backupHome.permissions", file_stat, BACKUP_HOME_MODE))
    access = os.R_OK | os.X_OK | (os.W_OK if write else 0)
    checks.append(_access_check("backupHome.access", backup_home, file_stat, access, "read/write/search" if write else "read/search"))

    return checks, file_stat


def handle_backup_home_validate(params: Any, config: HelperConfig, _dry_run: bool) -> Any:
    request = require_dict(params, "backupHome.validate params")
    reject_unknown_fields(request, {"backupHome", "dataDir"}, "backupHome.validate params")

    backup_home = Path(require_string(request.get("backupHome"), "backupHome"))
    data_dir = Path(require_string(request.get("dataDir"), "dataDir"))
    config_path = backup_home / CONFIG_NAME
    user = _current_user()

    checks, _backup_home_stat = _backup_home_checks(backup_home, config, user, write=True)

    data_dir_check, data_dir_stat = _path_check("dataDir.path", data_dir, "directory")
    checks.append(data_dir_check)
    checks.append(_access_check("dataDir.access", data_dir, data_dir_stat, os.R_OK | os.X_OK, "read/search"))

    config_path_check, config_stat = _path_check("config.path", config_path, "regular file")
    checks.append(config_path_check)
    checks.append(_owner_check("config.owner", config_stat, user))
    checks.append(_mode_check("config.permissions", config_stat, CONFIG_MODE))
    parse_check, section, parser = _read_backup_config(config_path, config_stat)
    config_datadir = None
    if parser is not None and section is not None:
        if parser.has_option(section, "datadir"):
            config_datadir = parser.get(section, "datadir").strip().strip("\"'")
        if not config_datadir:
            parse_check = _check("config.parse", "fail", "parseable config with datadir", "datadir missing", "Config must contain a datadir setting.")
    checks.append(parse_check)
    checks.append(_datadir_match(config_datadir, data_dir, data_dir_stat))

    response = _base_response(_validation_status(checks), backup_home, config_path, user, checks)
    response["dataDir"] = data_dir.as_posix()

    return response


def handle_backup_home_read_config(params: Any, config: HelperConfig, _dry_run: bool) -> Any:
    request = require_dict(params, "backupHome.readConfig params")
    reject_unknown_fields(request, {"backupHome"}, "backupHome.readConfig params")

    backup_home = Path(require_string(request.get("backupHome"), "backupHome"))
    config_path = backup_home / CONFIG_NAME
    user = _current_user()

    checks, _backup_home_stat = _backup_home_checks(backup_home, config, user, write=False)
    config_path_check, config_stat = _path_check("config.path", config_path, "regular file")
    checks.append(config_path_check)
    checks.append(_owner_check("config.owner", config_stat, user))
    checks.append(_mode_check("config.permissions", config_stat, CONFIG_MODE))
    parse_check, source_section, parser = _read_backup_config(config_path, config_stat)
    checks.append(parse_check)

    status = _validation_status(checks)
    if status != "valid" or parser is None or source_section is None:
        return _base_response(status, backup_home, config_path, user, checks)

    response = _base_response("read", backup_home, config_path, user, checks)
    response["sourceSection"] = source_section
    response["config"] = {
        result_key: parser.get(source_section, config_key)
        for config_key, result_key in SAFE_CONFIG_KEYS.items()
        if parser.has_option(source_section, config_key)
    }

    return response


def handle_backup_home_write_config(params: Any, config: HelperConfig, _dry_run: bool) -> Any:
    request = require_dict(params, "backupHome.writeConfig params")
    reject_unknown_fields(request, {"backupHome", "dataDir"}, "backupHome.writeConfig params")

    backup_home = Path(require_string(request.get("backupHome"), "backupHome"))
    data_dir = Path(require_string(request.get("dataDir"), "dataDir"))
    config_path = backup_home / CONFIG_NAME
    user = _current_user()

    checks, _backup_home_stat = _backup_home_checks(backup_home, config, user, write=True)
    data_dir_check, data_dir_stat = _path_check("dataDir.path", data_dir, "directory")
    checks.append(data_dir_check)
    checks.append(_access_check("dataDir.access", data_dir, data_dir_stat, os.R_OK | os.X_OK, "read/search"))
    config_path_check, _config_stat = _path_check("config.path", config_path, "regular file", missing_ok=True)
    checks.append(config_path_check)

    status = _validation_status(checks)
    if status != "valid" or data_dir_stat is None:
        response = _base_response(status, backup_home, config_path, user, checks)
        response["dataDir"] = data_dir.as_posix()

        return response

    values = _generated_config_values(backup_home, data_dir, config, user)
    try:
        _write_config_file(config_path, values)
    except OSError as error:
        response = _base_response("failed", backup_home, config_path, user, checks)
        response["dataDir"] = data_dir.as_posix()
        response["error"] = error.__class__.__name__

        return response

    response = _base_response("written", backup_home, config_path, user, checks)
    response["dataDir"] = values["datadir"]
    response["config"] = {SAFE_CONFIG_KEYS[key]: value for key, value in values.items()}

    return response


def _chown_action(action_id: str, path: Path, file_stat: os.stat_result, user: dict[str, Any]) -> dict[str, str]:
    if os.name != "posix":
        return _action(action_id, "failed", "unsupported platform", "unchanged", "Ownership repair is not available on this platform.")

    before = f"uid={file_stat.st_uid} gid={file_stat.st_gid}"
    after = f"uid={user['uid']}"
    if file_stat.st_uid == user["uid"]:
        return _action(action_id, "unchanged", before, after, "Owner is already correct.")

    try:
        os.chown(path, user["uid"], -1, follow_symlinks=False)
        repaired_stat = path.lstat()
    except OSError as error:
        return _action(action_id, "failed", before, after, f"Could not change owner: {error.__class__.__name__}.")

    return _action(action_id, "changed", before, f"uid={repaired_stat.st_uid} gid={repaired_stat.st_gid}", "Owner was updated.")


def _chmod_action(action_id: str, path: Path, file_stat: os.stat_result, mode: int) -> dict[str, str]:
    if os.name != "posix":
        return _action(action_id, "failed", "unsupported platform", "unchanged", "POSIX mode repair is not available on this platform.")

    before = _mode(file_stat)
    after = f"{mode:04o}"
    if before == after:
        return _action(action_id, "unchanged", before, after, "Permissions are already correct.")

    try:
        os.chmod(path, mode, follow_symlinks=False)
        repaired_stat = path.lstat()
    except (NotImplementedError, OSError) as error:
        return _action(action_id, "failed", before, after, f"Could not change permissions: {error.__class__.__name__}.")

    return _action(action_id, "changed", before, _mode(repaired_stat), "Permissions were updated.")


def handle_backup_home_repair(params: Any, config: HelperConfig, _dry_run: bool) -> Any:
    request = require_dict(params, "backupHome.repair params")
    reject_unknown_fields(request, {"backupHome"}, "backupHome.repair params")

    backup_home = Path(require_string(request.get("backupHome"), "backupHome"))
    config_path = backup_home / CONFIG_NAME
    user = _current_user()
    actions: list[dict[str, str]] = []

    backup_home_check, backup_home_stat = _path_check("backupHome.path", backup_home, "directory")
    if backup_home_stat is None:
        actions.append(_action("backupHome.path", "failed", backup_home_check["observed"], backup_home_check["expected"], backup_home_check["message"]))

        return {
            "status": "failed",
            "backupHome": backup_home.as_posix(),
            "configPath": config_path.as_posix(),
            "effectiveUser": user,
            "actions": actions,
        }

    root_check = _root_check(backup_home, backup_home_stat, config.backup_roots)
    if root_check["status"] != "pass":
        actions.append(_action("backupHome.root", "failed", root_check["observed"], root_check["expected"], root_check["message"]))

        return {
            "status": "failed",
            "backupHome": backup_home.as_posix(),
            "configPath": config_path.as_posix(),
            "effectiveUser": user,
            "actions": actions,
        }

    actions.append(_chown_action("backupHome.owner", backup_home, backup_home_stat, user))
    actions.append(_chmod_action("backupHome.permissions", backup_home, backup_home_stat, BACKUP_HOME_MODE))

    config_path_check, config_stat = _path_check("config.path", config_path, "regular file", missing_ok=True)
    if config_stat is None:
        status = "skipped" if config_path_check["status"] == "pass" else "failed"
        actions.append(_action("config.path", status, config_path_check["observed"], config_path_check["expected"], config_path_check["message"]))
    else:
        actions.append(_chown_action("config.owner", config_path, config_stat, user))
        actions.append(_chmod_action("config.permissions", config_path, config_stat, CONFIG_MODE))

    changed = any(action["status"] == "changed" for action in actions)
    failed = any(action["status"] == "failed" for action in actions)

    return {
        "status": "partial" if changed and failed else "failed" if failed else "repaired" if changed else "noop",
        "backupHome": backup_home.as_posix(),
        "configPath": config_path.as_posix(),
        "effectiveUser": user,
        "actions": actions,
    }


