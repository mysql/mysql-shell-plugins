MAX_REQUEST_BYTES = 1024 * 1024


def _write_json(value: dict[str, Any]) -> None:
    sys.stdout.write(json.dumps(value, separators=(",", ":")) + "\n")


def _read_json_request() -> Any:
    payload = sys.stdin.buffer.read(MAX_REQUEST_BYTES + 1)
    if len(payload) > MAX_REQUEST_BYTES:
        raise RuntimeError("request exceeds maximum helper request size.")

    return json.loads(payload.decode("utf-8"))


def _self_test(backup_home: Path | None = None) -> dict[str, Any]:
    result: dict[str, Any] = {
        "ok": True,
        "version": HELPER_VERSION,
        "capabilities": list(HANDLERS),
    }
    try:
        config = helper_config(backup_home)
    except HelperError as error:
        result["configLoaded"] = False
        result["configError"] = error.code

        return result

    result["configLoaded"] = True
    result["targetUser"] = config.target_user_name
    result["jobRunner"] = config.job_runner

    return result


def _default_backup_home() -> Path:
    helper_dir = Path(__file__).resolve().parent
    if helper_dir.name in {"bin", "sbin"}:
        return helper_dir.parent

    return helper_dir


def _run_job_cli(config: HelperConfig, args: list[str]) -> int:
    if len(args) != 2:
        _write_json({
            "ok": False,
            "operation": "jobs.execute",
            "error": {
                "code": "invalid_request",
                "message": "usage: task-helper run-job <jobId>",
            },
        })

        return 64

    response = handle_request({
        "operation": "jobs.execute",
        "params": {
            "backupHome": config.backup_home,
            "jobId": args[1],
            "runMode": "scheduled",
        },
    }, config)
    _write_json(response)
    if not response["ok"]:
        return 1

    result = response["result"]
    if result.get("status") == "skipped":
        return 0
    if result["timedOut"] or result["exitCode"] != 0:
        return 1

    return 0


def main() -> int:
    try:
        args = sys.argv[1:]
        backup_home = None
        if len(args) >= 2 and args[0] == "--backup-home":
            backup_home = _request_backup_home(args[1])
            args = args[2:]
        if args == ["--self-test"]:
            _write_json(_self_test(backup_home))

            return 0

        if args and args[0] == "run-job":
            if backup_home is None:
                raise HelperError("invalid_request", "--backup-home is required for run-job.")
            config = helper_config(backup_home)
            return _run_job_cli(config, args)
        if args:
            _write_json({
                "ok": False,
                "error": {
                    "code": "invalid_request",
                    "message": "Unsupported helper arguments.",
                },
            })

            return 64

        payload = _read_json_request()
        _write_json(handle_request(payload))

        return 0
    except Exception as error:
        _write_json({
            "ok": False,
            "error": {
                "code": "startup_error",
                "message": str(error),
            },
        })

        return 1


if __name__ == "__main__":
    raise SystemExit(main())
