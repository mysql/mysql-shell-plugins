def _prepare_private_file(path: Path, content: bytes = b"") -> None:
    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL
    if hasattr(os, "O_CLOEXEC"):
        flags |= os.O_CLOEXEC
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW

    fd = None
    try:
        fd = os.open(path, flags, JOB_STORE_MODE)
        opened_stat = os.fstat(fd)
        if not stat.S_ISREG(opened_stat.st_mode) or getattr(opened_stat, "st_nlink", 1) > 1:
            raise HelperError("invalid_request", f"{path.name} is not a regular private file.")
        if os.name == "posix":
            os.fchmod(fd, JOB_STORE_MODE)
        if content:
            os.write(fd, content)
    except OSError:
        raise HelperError("operation_failed", f"{path.name} could not be prepared.")
    finally:
        if fd is not None:
            os.close(fd)


def _delete_private_file(path: Path) -> None:
    try:
        file_stat = os.lstat(path)
        if not stat.S_ISREG(file_stat.st_mode) or getattr(file_stat, "st_nlink", 1) > 1:
            return
        path.unlink()
    except FileNotFoundError:
        return
    except OSError:
        return


def _private_regular_file_exists(path: Path) -> bool:
    try:
        file_stat = os.lstat(path)
        return stat.S_ISREG(file_stat.st_mode) and getattr(file_stat, "st_nlink", 1) == 1
    except OSError:
        return False


