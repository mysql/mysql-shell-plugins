def _entrypoint_path() -> str:
    script_path = Path(__file__).resolve()
    if os.name == "nt" and script_path.name == "task-helper.py":
        return script_path.with_name("task-helper.cmd").as_posix()

    return script_path.as_posix()


def _read_helper_config_file(backup_home: Path | None = None) -> configparser.RawConfigParser:
    path = (backup_home or _default_backup_home()) / CONFIG_NAME
    try:
        file_stat = path.lstat()
    except OSError:
        raise HelperError("invalid_config", f"{CONFIG_NAME} is missing.")

    if not stat.S_ISREG(file_stat.st_mode):
        raise HelperError("invalid_config", f"{CONFIG_NAME} must be a regular file, not a symlink or directory.")
    if file_stat.st_size > MAX_CONFIG_BYTES:
        raise HelperError("invalid_config", f"{CONFIG_NAME} is too large.")

    if os.name == "posix":
        effective_uid = os.geteuid()
        if file_stat.st_uid not in {effective_uid, 0}:
            raise HelperError("invalid_config", f"{CONFIG_NAME} must be owned by root or the effective helper user.")
        if file_stat.st_mode & 0o022:
            raise HelperError("invalid_config", f"{CONFIG_NAME} must not be group or world writable.")
        for parent in path.parents:
            parent_stat = parent.lstat()
            if not stat.S_ISDIR(parent_stat.st_mode):
                raise HelperError("invalid_config", f"{CONFIG_NAME} parent paths must be directories.")
            if parent_stat.st_uid not in {effective_uid, 0}:
                raise HelperError("invalid_config", f"{CONFIG_NAME} parent paths must be owned by root or the effective helper user.")
            if parent_stat.st_mode & 0o022:
                raise HelperError("invalid_config", f"{CONFIG_NAME} parent paths must not be group or world writable.")

    flags = os.O_RDONLY
    if hasattr(os, "O_CLOEXEC"):
        flags |= os.O_CLOEXEC
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW

    fd = None
    try:
        fd = os.open(path, flags)
        opened_stat = os.fstat(fd)
        if os.name == "posix" and (opened_stat.st_dev != file_stat.st_dev or opened_stat.st_ino != file_stat.st_ino):
            raise HelperError("invalid_config", f"{CONFIG_NAME} changed while opening.")
        if not stat.S_ISREG(opened_stat.st_mode):
            raise HelperError("invalid_config", f"{CONFIG_NAME} must be a regular file.")

        with os.fdopen(fd, "r", encoding="utf-8") as config_file:
            fd = None
            parser = configparser.RawConfigParser()
            parser.optionxform = str.lower
            parser.read_file(config_file)
    except HelperError:
        raise
    except (OSError, UnicodeDecodeError, configparser.Error):
        raise HelperError("invalid_config", f"{CONFIG_NAME} could not be read.")
    finally:
        if fd is not None:
            os.close(fd)

    return parser


def _config_section(parser: configparser.RawConfigParser) -> str:
    for section in ("meb", "meb_manager"):
        if parser.has_section(section):
            return section

    raise HelperError("invalid_config", f"{CONFIG_NAME} must contain a [meb] section.")


def _config_get(parser: configparser.RawConfigParser, section: str, key: str) -> str:
    if not parser.has_option(section, key):
        raise HelperError("invalid_config", f"{CONFIG_NAME} is missing {key}.")

    return require_string(parser.get(section, key).strip(), key)


def _config_get_int(parser: configparser.RawConfigParser, section: str, key: str, default: int) -> int:
    if not parser.has_option(section, key):
        return default

    try:
        value = parser.getint(section, key)
    except ValueError:
        raise HelperError("invalid_config", f"{key} must be an integer.")

    if value < 1:
        raise HelperError("invalid_config", f"{key} must be positive.")

    return value


def _config_get_path(parser: configparser.RawConfigParser, section: str, key: str) -> str:
    path = _config_get(parser, section, key)
    if not Path(path).is_absolute():
        raise HelperError("invalid_config", f"{key} must be an absolute path.")

    return path


def helper_config(backup_home: Path | None = None) -> HelperConfig:
    selected_backup_home = backup_home or _default_backup_home()
    if not selected_backup_home.is_absolute():
        raise HelperError("invalid_config", "backupHome must be an absolute path.")
    try:
        selected_backup_home = selected_backup_home.resolve(strict=True)
    except OSError:
        raise HelperError("invalid_config", "backupHome does not exist.")
    if not selected_backup_home.is_dir():
        raise HelperError("invalid_config", "backupHome must be a directory.")

    parser = _read_helper_config_file(selected_backup_home)
    section = _config_section(parser)
    for key, _value in parser.items(section):
        if key not in SAFE_CONFIG_KEYS:
            raise HelperError("invalid_config", f"{CONFIG_NAME} contains unsupported field '{key}'.")

    target_user_name = _config_get(parser, section, "backup_os_user")
    try:
        uid = parser.getint(section, "backup_os_uid") if parser.has_option(section, "backup_os_uid") else None
        gid = parser.getint(section, "backup_os_gid") if parser.has_option(section, "backup_os_gid") else None
    except ValueError:
        raise HelperError("invalid_config", "backup_os_uid and backup_os_gid must be integers.")
    if (uid is not None and uid < 0) or (gid is not None and gid < 0):
        raise HelperError("invalid_config", "backup_os_uid and backup_os_gid must be non-negative.")
    if (uid is None) != (gid is None):
        raise HelperError("invalid_config", "backup_os_uid and backup_os_gid must be set together.")

    job_runner = _config_get(parser, section, "job_runner")
    if job_runner == "self":
        job_runner = _entrypoint_path()
    elif not Path(job_runner).is_absolute():
        raise HelperError("invalid_config", "job_runner must be an absolute path or 'self'.")

    scheduler_backend = _config_get(parser, section, "scheduler_backend")
    if scheduler_backend not in {"platform", "cron", "launchd", "schtasks"}:
        raise HelperError("invalid_config", "scheduler_backend is not supported.")

    return HelperConfig(
        target_user_name=target_user_name,
        target_user=TargetUser(
            uid=uid,
            gid=gid,
            account=target_user_name,
            windows_logon_type=parser.get(section, "windows_logon_type", fallback="ServiceAccount"),
        ),
        mysqlbackup=_config_get_path(parser, section, "mysqlbackup"),
        login_file=_config_get_path(parser, section, "login_file"),
        login_path=_config_get(parser, section, "login_path"),
        crontab=_config_get_path(parser, section, "crontab"),
        job_runner=job_runner,
        backup_roots=[_config_get_path(parser, section, "backup_root")],
        option_file_roots=[_config_get_path(parser, section, "option_file_root")],
        working_directory=_config_get_path(parser, section, "working_directory"),
        timeout_ms=_config_get_int(parser, section, "timeout_ms", DEFAULT_TIMEOUT_MS),
        max_output_bytes=_config_get_int(parser, section, "max_output_bytes", DEFAULT_MAX_OUTPUT_BYTES),
        backup_home=selected_backup_home.as_posix(),
        launchctl=_config_get_path(parser, section, "launchctl"),
        schtasks=_config_get_path(parser, section, "schtasks") if os.name != "nt" else _config_get(parser, section, "schtasks"),
        scheduler_backend=scheduler_backend,
        launchd_plist_dir=_config_get_path(parser, section, "launchd_plist_dir"),
        windows_task_folder=_config_get(parser, section, "windows_task_folder"),
        datadir=_config_get_path(parser, section, "datadir"),
    )


def resolve_target_user(config: HelperConfig) -> TargetUser:
    target_user = config.target_user
    if os.name != "posix" or (target_user.uid is not None and target_user.gid is not None):
        return target_user

    account = target_user.account or config.target_user_name
    try:
        entry = pwd.getpwnam(account)
    except KeyError:
        raise HelperError("invalid_config", f"configured target user '{account}' does not exist.")

    return TargetUser(
        uid=entry.pw_uid,
        gid=entry.pw_gid,
        account=account,
        windows_logon_type=target_user.windows_logon_type,
    )

# Process runner
def redact_plan(plan: ProcessPlan) -> dict[str, Any]:
    return {
        "executable": plan.executable,
        "args": plan.args,
        "stdin": "<redacted>" if plan.stdin else "<empty>",
        "cwd": plan.cwd,
        "env": plan.env,
        "uid": plan.uid,
        "gid": plan.gid,
        "account": plan.account,
        "timeoutMs": plan.timeout_ms,
        "maxOutputBytes": plan.max_output_bytes,
        "auditName": plan.audit_name,
        "logPath": plan.log_path,
        "outputPath": plan.output_path,
        "progressPath": plan.progress_path,
    }


def process_status(result: dict[str, Any]) -> dict[str, Any]:
    status = {
        "exitCode": result["exitCode"],
        "timedOut": result["timedOut"],
        "stdoutTruncated": result["stdoutTruncated"],
        "stderrTruncated": result["stderrTruncated"],
    }
    if result.get("logPath") is not None:
        status["logPath"] = result["logPath"]

    return status


def scheduler_status(
    result: dict[str, Any],
    success_status: str,
    action: str,
    not_found_markers: tuple[str, ...] = (),
) -> dict[str, Any]:
    status = process_status(result)
    output = str(result.get("stderr") or result.get("stdout") or "")
    detail = " ".join(output.split())[:1024]

    if (
        not result["timedOut"]
        and result["exitCode"] != 0
        and any(marker in output.lower() for marker in not_found_markers)
    ):
        status["status"] = "notFound"
        status["message"] = "Scheduled backup job was already absent."
    elif result["timedOut"]:
        status["status"] = "failed"
        status["message"] = f"{action} timed out."
    elif result["exitCode"] != 0:
        status["status"] = "failed"
        status["message"] = detail or f"{action} failed with exit code {result['exitCode']}."
    else:
        status["status"] = success_status

    return status


def scheduler_not_found_status() -> dict[str, Any]:
    return {
        "exitCode": 0,
        "timedOut": False,
        "stdoutTruncated": False,
        "stderrTruncated": False,
        "status": "notFound",
        "message": "Scheduled backup job was already absent.",
    }


def validate_process_plan(plan: ProcessPlan) -> None:
    if not Path(plan.executable).is_absolute():
        raise HelperError("invalid_plan", "executable must be absolute.")

    if not Path(plan.cwd).is_absolute():
        raise HelperError("invalid_plan", "cwd must be absolute.")

    if "\0" in plan.executable:
        raise HelperError("invalid_plan", "executable must not contain NUL bytes.")

    if "\0" in plan.cwd:
        raise HelperError("invalid_plan", "cwd must not contain NUL bytes.")

    for index, arg in enumerate(plan.args):
        if "\0" in arg:
            raise HelperError("invalid_plan", f"args[{index}] must not contain NUL bytes.")

    for key, value in plan.env.items():
        if re.fullmatch(r"[A-Z0-9_]+", key) is None:
            raise HelperError("invalid_plan", f"environment key '{key}' is not allowlisted.")
        if "\0" in value:
            raise HelperError("invalid_plan", f"env.{key} must not contain NUL bytes.")

    if (plan.uid is not None and plan.uid < 0) or (plan.gid is not None and plan.gid < 0):
        raise HelperError("invalid_plan", "uid and gid must be non-negative.")

    if (plan.uid is None) != (plan.gid is None):
        raise HelperError("invalid_plan", "uid and gid must be set together.")

    if plan.timeout_ms < 1:
        raise HelperError("invalid_plan", "timeoutMs must be positive.")

    if plan.max_output_bytes < 1:
        raise HelperError("invalid_plan", "maxOutputBytes must be positive.")

    if plan.stdin is not None and len(plan.stdin.encode("utf-8")) > plan.max_output_bytes:
        raise HelperError("invalid_plan", "stdin exceeds maxOutputBytes.")

    if plan.log_path is not None:
        if not Path(plan.log_path).is_absolute():
            raise HelperError("invalid_plan", "logPath must be absolute.")
        if "\0" in plan.log_path:
            raise HelperError("invalid_plan", "logPath must not contain NUL bytes.")

    if plan.progress_path is not None:
        if not Path(plan.progress_path).is_absolute():
            raise HelperError("invalid_plan", "progressPath must be absolute.")
        if "\0" in plan.progress_path:
            raise HelperError("invalid_plan", "progressPath must not contain NUL bytes.")


def validate_executable_reference(executable: str) -> None:
    try:
        executable_stat = os.lstat(executable)
    except OSError:
        raise HelperError("invalid_plan", "executable must exist.")

    if not stat.S_ISREG(executable_stat.st_mode):
        raise HelperError("invalid_plan", "executable must be a regular file, not a symlink or directory.")

    if os.name == "nt":
        if Path(executable).suffix.lower() != ".exe":
            raise HelperError("invalid_plan", "Windows executables must be .exe files.")

        return

    if executable_stat.st_mode & 0o111 == 0:
        raise HelperError("invalid_plan", "executable must have an executable permission bit set.")

    if executable_stat.st_mode & 0o022:
        raise HelperError("invalid_plan", "executable must not be group or world writable.")

    if os.name == "posix" and os.geteuid() == 0 and executable_stat.st_uid != 0:
        raise HelperError("invalid_plan", "executable must be owned by root.")

    for ancestor in Path(executable).parents:
        ancestor_stat = os.lstat(ancestor)
        if not stat.S_ISDIR(ancestor_stat.st_mode):
            raise HelperError("invalid_plan", "executable parent paths must be directories.")

        if ancestor_stat.st_mode & 0o022:
            raise HelperError("invalid_plan", "executable parent paths must not be group or world writable.")

        if os.name == "posix" and os.geteuid() == 0 and ancestor_stat.st_uid != 0:
            raise HelperError("invalid_plan", "executable parent paths must be owned by root.")


def _terminate_process(process: subprocess.Popen[Any]) -> None:
    if process.poll() is not None:
        return

    if os.name != "posix":
        process.terminate()
        try:
            process.wait(timeout=5)
        except subprocess.TimeoutExpired:
            process.kill()
        return

    try:
        os.killpg(process.pid, signal.SIGTERM)
    except ProcessLookupError:
        return
    except PermissionError:
        process.terminate()

    try:
        process.wait(timeout=5)
    except subprocess.TimeoutExpired:
        try:
            os.killpg(process.pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
        except PermissionError:
            process.kill()


def _terminate_process_group_by_pid(pid: int) -> None:
    if pid < 1:
        raise HelperError("invalid_request", "restore process ID is invalid.")

    try:
        if os.name == "posix":
            os.killpg(pid, signal.SIGTERM)
        else:
            os.kill(pid, signal.SIGTERM)
    except ProcessLookupError:
        return
    except OSError:
        raise HelperError("operation_failed", "restore process could not be aborted.")

    deadline = time.monotonic() + 5
    while _process_exists(pid) and time.monotonic() < deadline:
        time.sleep(0.1)
    if not _process_exists(pid):
        return

    try:
        if os.name == "posix":
            os.killpg(pid, signal.SIGKILL)
        else:
            os.kill(pid, signal.SIGKILL)
    except ProcessLookupError:
        return
    except OSError:
        raise HelperError("operation_failed", "restore process could not be killed after abort.")


def _windows_current_account_matches(account: str) -> bool:
    user_domain = os.environ.get("USERDOMAIN", "")
    user_name = os.environ.get("USERNAME", "")
    if not user_name:
        return False

    current = f"{user_domain}\\{user_name}" if user_domain else user_name
    return account.casefold() == current.casefold()


class ProcessProgressTracker:
    def __init__(self, path: str, context: dict[str, Any] | None) -> None:
        self.path = Path(path)
        self.state = {
            "version": 1,
            "state": "running",
            **(context or {}),
        }
        self.lock = threading.Lock()

    def start(self) -> None:
        self.state["updatedTime"] = int(time.time())
        self._write()

    def finish(self, exit_code: int | None, timed_out: bool) -> None:
        with self.lock:
            end_time = int(time.time())
            self.state["state"] = "finished"
            self.state["updatedTime"] = end_time
            self.state["endTime"] = end_time
            self.state["exitCode"] = exit_code
            self.state["timedOut"] = timed_out
            self._write()

    def update(self, values: dict[str, Any]) -> None:
        with self.lock:
            self.state.update(values)
            self.state["updatedTime"] = int(time.time())
            self._write()

    def _write(self) -> None:
        _write_json_store(self.path, self.state)


def _read_process_stream(
    stream: Any,
    stream_name: str,
    output: bytearray,
    combined_output: bytearray,
    log_fd: int | None,
    output_fd: int | None,
    log_lock: threading.Lock,
    written: dict[str, int],
    truncated: dict[str, bool],
    limit: int,
    process: subprocess.Popen[Any],
) -> None:
    while True:
        chunk = os.read(stream.fileno(), 8192)
        if not chunk:
            return

        with log_lock:
            combined_available = limit - len(combined_output)
            if combined_available > 0:
                combined_chunk = chunk[:combined_available]
                combined_output.extend(combined_chunk)
                if output_fd is not None:
                    os.write(output_fd, combined_chunk)
            if log_fd is not None:
                _write_log_chunk(log_fd, stream_name, chunk, written, truncated, limit)

        available = limit - len(output)
        if available <= 0:
            truncated[stream_name] = True
            if log_fd is None:
                _terminate_process(process)
                return
            continue

        output.extend(chunk[:available])
        if len(chunk) > available:
            truncated[stream_name] = True
            if log_fd is None:
                _terminate_process(process)
                return


def _open_process_log(path: str) -> int:
    flags = os.O_WRONLY | os.O_APPEND
    if hasattr(os, "O_CLOEXEC"):
        flags |= os.O_CLOEXEC
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW

    try:
        file_stat = os.lstat(path)
        if not stat.S_ISREG(file_stat.st_mode):
            raise HelperError("invalid_plan", "logPath must be a regular file, not a symlink or directory.")
        if getattr(file_stat, "st_nlink", 1) > 1:
            raise HelperError("invalid_plan", "logPath must not be a hard link.")
        if os.name == "posix" and stat.S_IMODE(file_stat.st_mode) != 0o600:
            raise HelperError("invalid_plan", "logPath permissions must be 0600.")
        fd = os.open(path, flags)
        opened_stat = os.fstat(fd)
        if os.name == "posix" and (opened_stat.st_dev != file_stat.st_dev or opened_stat.st_ino != file_stat.st_ino):
            os.close(fd)
            raise HelperError("invalid_plan", "logPath changed while opening.")
        if not stat.S_ISREG(opened_stat.st_mode):
            os.close(fd)
            raise HelperError("invalid_plan", "logPath must be a regular file.")
        if getattr(opened_stat, "st_nlink", 1) > 1:
            os.close(fd)
            raise HelperError("invalid_plan", "logPath must not be a hard link.")

        return fd
    except HelperError:
        raise
    except OSError:
        raise HelperError("invalid_plan", "logPath could not be opened.")


def _write_log_line(log_fd: int, message: str) -> None:
    os.write(log_fd, message.encode("utf-8", errors="replace"))


def _write_log_chunk(
    log_fd: int,
    stream_name: str,
    chunk: bytes,
    written: dict[str, int],
    truncated: dict[str, bool],
    limit: int,
) -> None:
    available = limit - written[stream_name]
    if available <= 0:
        truncated[stream_name] = True
        return

    payload = chunk[:available]
    if not payload:
        truncated[stream_name] = True
        return

    _write_log_line(log_fd, f"\n--- {stream_name} ---\n")
    os.write(log_fd, payload)
    written[stream_name] += len(payload)
    if len(chunk) > available:
        truncated[stream_name] = True


def run_process_plan(plan: ProcessPlan) -> dict[str, Any]:
    validate_process_plan(plan)
    validate_executable_reference(plan.executable)

    popen_args: dict[str, Any] = {
        "cwd": plan.cwd,
        "env": plan.env,
        "stdout": subprocess.PIPE,
        "stderr": subprocess.PIPE,
        "shell": False,
    }
    if os.name == "nt":
        if plan.account is not None and not _windows_current_account_matches(plan.account):
            raise HelperError("not_authorized", "Windows direct execution cannot switch accounts.")
        popen_args["creationflags"] = subprocess.CREATE_NEW_PROCESS_GROUP
    elif os.name == "posix":
        if plan.uid is None or plan.gid is None:
            raise HelperError("invalid_plan", "uid and gid are required on POSIX platforms.")
        if os.geteuid() == 0:
            popen_args.update({
                "user": plan.uid,
                "group": plan.gid,
                "extra_groups": [],
            })
        elif plan.uid != os.geteuid() or plan.gid != os.getegid():
            raise HelperError("not_authorized", "helper must run as root to switch users.")
        popen_args.update({
            "start_new_session": True,
            "umask": 0o077,
        })
    else:
        raise HelperError("unsupported_platform", "process execution is not supported on this platform.")

    stdin_file = None
    popen_args["stdin"] = subprocess.DEVNULL
    if plan.stdin is not None:
        stdin_file = tempfile.TemporaryFile("w+b")
        stdin_file.write(plan.stdin.encode("utf-8"))
        stdin_file.seek(0)
        popen_args["stdin"] = stdin_file

    progress_tracker = ProcessProgressTracker(plan.progress_path, plan.progress_context) if plan.progress_path is not None else None
    if progress_tracker is not None:
        progress_tracker.start()

    log_fd = None
    output_fd = None
    try:
        log_fd = _open_process_log(plan.log_path) if plan.log_path is not None else None
        output_fd = _open_process_log(plan.output_path) if plan.output_path is not None else None
    except Exception:
        if progress_tracker is not None:
            progress_tracker.finish(1, False)
        if log_fd is not None:
            os.close(log_fd)
        raise
    if log_fd is not None:
        _write_log_line(log_fd, f"# {plan.audit_name} started\n")

    try:
        process = subprocess.Popen([plan.executable, *plan.args], **popen_args)
        if progress_tracker is not None:
            progress_tracker.update({"pid": process.pid, "state": "running"})
    except Exception:
        if progress_tracker is not None:
            progress_tracker.finish(1, False)
        if log_fd is not None:
            os.close(log_fd)
        if output_fd is not None:
            os.close(output_fd)
        raise
    finally:
        if stdin_file is not None:
            stdin_file.close()

    assert process.stdout is not None
    assert process.stderr is not None
    output = {"stdout": bytearray(), "stderr": bytearray()}
    combined_output = bytearray()
    log_written = {"stdout": 0, "stderr": 0}
    truncated = {"stdout": False, "stderr": False}
    log_lock = threading.Lock()
    stdout_thread = threading.Thread(
        target=_read_process_stream,
        args=(
            process.stdout, "stdout", output["stdout"], combined_output, log_fd, output_fd, log_lock,
            log_written, truncated,
            plan.max_output_bytes, process,
        ),
    )
    stderr_thread = threading.Thread(
        target=_read_process_stream,
        args=(
            process.stderr, "stderr", output["stderr"], combined_output, log_fd, output_fd, log_lock,
            log_written, truncated,
            plan.max_output_bytes, process,
        ),
    )
    stdout_thread.start()
    stderr_thread.start()
    timed_out = False

    try:
        process.wait(timeout=plan.timeout_ms / 1000)
    except subprocess.TimeoutExpired:
        timed_out = True
        _terminate_process(process)

    stdout_thread.join(timeout=5)
    stderr_thread.join(timeout=5)
    process.stdout.close()
    process.stderr.close()
    if progress_tracker is not None:
        progress_tracker.finish(process.returncode, timed_out)
    if log_fd is not None:
        _write_log_line(log_fd, f"\n# {plan.audit_name} finished exitCode={process.returncode} timedOut={json.dumps(timed_out)} stdoutTruncated={json.dumps(truncated['stdout'])} stderrTruncated={json.dumps(truncated['stderr'])}\n")
        os.close(log_fd)
    if output_fd is not None:
        os.close(output_fd)

    return {
        "exitCode": process.returncode,
        "stdout": output["stdout"].decode("utf-8", errors="replace"),
        "stderr": output["stderr"].decode("utf-8", errors="replace"),
        "output": combined_output.decode("utf-8", errors="replace"),
        "timedOut": timed_out,
        "stdoutTruncated": truncated["stdout"],
        "stderrTruncated": truncated["stderr"],
        "logPath": plan.log_path,
    }

