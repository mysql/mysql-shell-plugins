def _read_current_crontab(config: HelperConfig) -> str:
    result = run_process_plan(_crontab_read_plan(config))
    if result["timedOut"] or result["stdoutTruncated"] or result["stderrTruncated"]:
        raise HelperError("operation_failed", "Unable to safely read existing crontab.")

    if result["exitCode"] == 0:
        return str(result["stdout"])

    if result["exitCode"] == 1 and "no crontab" in str(result["stderr"]).lower():
        return ""

    raise HelperError("operation_failed", "Unable to read existing crontab.")


def handle_cron_install_managed_job(params: Any, config: HelperConfig, dry_run: bool) -> Any:
    job_id, schedule = _require_job(params, "cron.installManagedJob", with_schedule=True)
    assert schedule is not None

    backend = _scheduler_backend(config)
    if backend == "launchd":
        return _install_launchd_job(config, job_id, schedule, dry_run)

    if backend == "schtasks":
        return _install_windows_task(config, job_id, schedule, dry_run)

    if dry_run:
        placeholder = install_managed_job_block("", config, job_id, schedule)
        plan = _crontab_write_plan(config, placeholder)

        return {
            "plan": redact_plan(plan),
            "generatedManagedBlock": render_managed_job_block(config, job_id, schedule),
        }

    current = _read_current_crontab(config)
    next_crontab = install_managed_job_block(current, config, job_id, schedule)

    result = run_process_plan(_crontab_write_plan(config, next_crontab))

    return scheduler_status(result, "installed", "Installing the scheduled backup job")


def handle_cron_remove_managed_job(params: Any, config: HelperConfig, dry_run: bool) -> Any:
    job_id, _schedule = _require_job(params, "cron.removeManagedJob", with_schedule=False)

    backend = _scheduler_backend(config)
    if backend == "launchd":
        return _remove_launchd_job(config, job_id, dry_run)

    if backend == "schtasks":
        return _remove_windows_task(config, job_id, dry_run)

    if dry_run:
        return {"plan": redact_plan(_crontab_write_plan(config, ""))}

    current = _read_current_crontab(config)
    if _managed_block_indexes(current.splitlines(), job_id) is None:
        return scheduler_not_found_status()

    next_crontab = f"{remove_managed_job_block(current, job_id)}\n"
    result = run_process_plan(_crontab_write_plan(config, next_crontab))

    return scheduler_status(result, "removed", "Removing the scheduled backup job")

