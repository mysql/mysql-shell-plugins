def handle_backups_restore_progress(params: Any, config: HelperConfig, _dry_run: bool) -> Any:
    backup_home, operation_id, progress = _restore_operation_context(params, config)
    if progress.get("backupMode") != "restore" or progress.get("operationId") != operation_id:
        return {"state": "starting", "operationId": operation_id, "output": ""}

    state = str(progress.get("state") or "starting")
    if _private_regular_file_exists(_restore_abort_path(backup_home, operation_id)):
        state = "aborting"

    return {
        "state": state,
        "operationId": operation_id,
        "output": _read_private_output(_restore_output_path(backup_home, operation_id), config, _current_user()),
    }


def handle_backups_restore_abort(params: Any, config: HelperConfig, _dry_run: bool) -> Any:
    backup_home, operation_id, progress = _restore_operation_context(params, config)
    if progress.get("backupMode") != "restore" or progress.get("operationId") != operation_id:
        raise HelperError("invalid_request", "matching active restore operation was not found.")
    if progress.get("state") != "running":
        raise HelperError("invalid_request", "restore operation is not running.")

    lock_dir = _run_lock_path(backup_home)
    lock_owner = _read_run_lock_owner(lock_dir)
    if (
        lock_owner is None
        or lock_owner.get("jobId") != "restore-backup"
        or lock_owner.get("operationId") != operation_id
        or _lock_is_stale(lock_dir)
    ):
        raise HelperError("invalid_request", "matching active restore lock was not found.")

    pid = progress.get("pid")
    if not isinstance(pid, int) or pid < 1:
        raise HelperError("operation_failed", "restore process is not ready to be aborted.")

    marker_path = _restore_abort_path(backup_home, operation_id)
    _prepare_private_file(marker_path, b"abort\n")
    try:
        _terminate_process_group_by_pid(pid)
    except Exception:
        _delete_private_file(marker_path)
        raise

    return {
        "state": "aborting",
        "operationId": operation_id,
        "output": _read_private_output(_restore_output_path(backup_home, operation_id), config, _current_user()),
    }


def handle_backups_restore(params: Any, config: HelperConfig, dry_run: bool) -> Any:
    request = require_dict(params, "backups.restore params")
    reject_unknown_fields(
        request, {"backupHome", "backupId", "operationId", "profileId", "force"}, "backups.restore params",
    )

    user = _current_user()
    backup_home = _require_valid_backup_home(Path(require_string(request.get("backupHome"), "backupHome")), config, user, write=True)
    relative_path = _require_safe_relative_path(request.get("backupId"), "backupId")
    operation_id = require_safe_identifier(request.get("operationId"), "operationId")
    profile_id = request.get("profileId")
    if profile_id is not None:
        profile_id = require_safe_identifier(profile_id, "profileId")
    target_path, file_stat = _require_backup_child_path(backup_home, relative_path, "backupId")
    if not stat.S_ISDIR(file_stat.st_mode):
        raise HelperError("invalid_request", "backupId must name a backup directory.")
    force = request.get("force", False)
    if not isinstance(force, bool):
        raise HelperError("invalid_request", "force must be a boolean.")

    restore_defaults_file = target_path / ".restore-dry-run.cnf" if dry_run else _write_restore_defaults_file(target_path, config.datadir)
    restore_output_path = _restore_output_path(backup_home, operation_id)
    restore_abort_path = _restore_abort_path(backup_home, operation_id)
    try:
        plan = _mysqlbackup_restore_plan_for_backup(target_path, restore_defaults_file, config, force=force)
        mysqlbackup_progress_path = _mysqlbackup_progress_path(backup_home)
        plan = _with_mysqlbackup_progress_file(plan, mysqlbackup_progress_path)
        if dry_run:
            return {
                "backupHome": backup_home.as_posix(),
                "backupId": relative_path.as_posix(),
                "operationId": operation_id,
                "path": target_path.as_posix(),
                "plan": redact_plan(plan),
            }

        start_time = int(time.time())
        restore_log_id = f"restore-{profile_id}-{relative_path.name}" if profile_id else f"restore-{relative_path.name}"
        log_path = _new_job_log_path(backup_home, restore_log_id, user).as_posix()
        _prepare_private_file(restore_output_path)
        _delete_private_file(restore_abort_path)
        _prepare_mysqlbackup_progress_file(mysqlbackup_progress_path)
        plan = replace(
            plan,
            log_path=log_path,
            output_path=restore_output_path.as_posix(),
            progress_path=_progress_state_path(backup_home).as_posix(),
            progress_context={
                "state": "starting",
                "jobId": f"restore-{relative_path.as_posix()}",
                "backupMode": "restore",
                "operationId": operation_id,
                "runMode": "manual",
                "startedTime": start_time,
                "logPath": log_path,
                "mysqlbackupProgressPath": mysqlbackup_progress_path.as_posix(),
            },
        )
        run_lock = BackupRunLock(backup_home, "restore-backup", "manual", operation_id)
        if not run_lock.try_acquire():
            raise HelperError("backup_running", "Another backup or restore operation is already running.")

        with run_lock:
            result = run_process_plan(plan)

        aborted = _private_regular_file_exists(restore_abort_path)
        status = "aborted" if aborted else "failed" if result["exitCode"] != 0 or result["timedOut"] else "restored"

        response = {
            "status": status,
            "backupHome": backup_home.as_posix(),
            "backupId": relative_path.as_posix(),
            "operationId": operation_id,
            "path": target_path.as_posix(),
            **process_status(result),
        }
        if status in {"failed", "aborted"}:
            response["stdout"] = result["stdout"]
            response["stderr"] = result["stderr"]
            response["output"] = result.get("output") or "\n\n".join(
                stream.rstrip() for stream in (result["stdout"], result["stderr"]) if stream.strip()
            )

        return response
    finally:
        if not dry_run:
            try:
                _delete_restore_defaults_file(restore_defaults_file)
            finally:
                _delete_private_file(restore_output_path)
                _delete_private_file(restore_abort_path)


