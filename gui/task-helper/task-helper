def _validate_option_file_permissions(path: str, target_uid: int | None) -> None:
    file_stat = os.stat(path)
    if os.name != "posix":
        return

    if file_stat.st_mode & 0o022:
        raise HelperError("invalid_request", "defaultsFile must not be group or world writable.")

    if os.geteuid() == 0 and file_stat.st_uid not in {0, target_uid}:
        raise HelperError("invalid_request", "defaultsFile must be owned by root or the target user.")


def _path_under_roots(value: str, roots: list[str], label: str, *, file: bool = False) -> str:
    path = Path(value)
    if not path.is_absolute():
        raise HelperError("invalid_request", f"{label} must be an absolute path.")

    try:
        candidate = path.resolve(strict=True)
        resolved_roots = [Path(root).resolve(strict=True) for root in roots]
    except OSError:
        raise HelperError("invalid_request", f"{label} must exist.")

    if file and not candidate.is_file():
        raise HelperError("invalid_request", f"{label} must be a file.")
    if not file and not candidate.is_dir():
        raise HelperError("invalid_request", f"{label} must be a directory.")

    if not any(candidate == root or root in candidate.parents for root in resolved_roots):
        raise HelperError("invalid_request", f"{label} is outside the configured allowlisted roots.")

    return candidate.as_posix()


