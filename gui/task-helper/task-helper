def _checked_log_dir(backup_home: Path, user: dict[str, Any], *, create: bool = False, missing_ok: bool = False) -> Path | None:
    log_dir = backup_home / JOB_LOG_DIR_NAME
    error_code = "operation_failed" if create else "invalid_request"
    if create:
        try:
            log_dir.mkdir(mode=JOB_LOG_DIR_MODE)
        except FileExistsError:
            pass
        except OSError:
            raise HelperError("operation_failed", "log directory could not be created.")

    try:
        log_dir_stat = log_dir.lstat()
    except OSError:
        if missing_ok:
            return None
        raise HelperError(error_code, "log directory is not usable.")

    if not stat.S_ISDIR(log_dir_stat.st_mode):
        raise HelperError(error_code, "log directory must be a directory, not a symlink or file.")

    if os.name == "posix":
        if log_dir_stat.st_uid != user["uid"]:
            raise HelperError(error_code, "log directory must be owned by the effective helper user.")
        if stat.S_IMODE(log_dir_stat.st_mode) != JOB_LOG_DIR_MODE:
            if not create:
                raise HelperError("invalid_request", f"log directory permissions must be {JOB_LOG_DIR_MODE:04o}.")
            try:
                os.chmod(log_dir, JOB_LOG_DIR_MODE, follow_symlinks=False)
            except (NotImplementedError, OSError):
                raise HelperError("operation_failed", "log directory permissions could not be repaired.")

    return log_dir


def _new_job_log_path(backup_home: Path, job_id: str, user: dict[str, Any]) -> Path:
    log_dir = _checked_log_dir(backup_home, user, create=True)
    assert log_dir is not None
    timestamp = time.strftime("%Y%m%dT%H%M%SZ", time.gmtime())
    fd = None
    try:
        fd, log_name = tempfile.mkstemp(prefix=f"{timestamp}-{job_id}-", suffix=".log", dir=log_dir)
        if os.name == "posix":
            os.chmod(log_name, JOB_LOG_FILE_MODE)
    except OSError:
        raise HelperError("operation_failed", "log file could not be created.")
    finally:
        if fd is not None:
            os.close(fd)

    return Path(log_name)


def _require_request_int(value: Any, label: str) -> int:
    if not isinstance(value, int) or isinstance(value, bool):
        raise HelperError("invalid_request", f"{label} must be an integer.")

    return value


def _require_safe_relative_path(value: Any, label: str) -> Path:
    text = require_string(value, label)
    if text.startswith("/") or "\\" in text or "\n" in text or "\r" in text:
        raise HelperError("invalid_request", f"{label} must be a safe relative path.")

    parts = text.split("/")
    if len(parts) == 0 or any(part in {"", ".", ".."} for part in parts):
        raise HelperError("invalid_request", f"{label} must be a safe relative path.")

    for index, part in enumerate(parts):
        require_safe_identifier(part, f"{label}[{index}]")

    if parts[0] in RESERVED_BACKUP_HOME_NAMES:
        raise HelperError("invalid_request", f"{label} names a reserved backup-home entry.")

    return Path(*parts)


def _require_backup_child_path(backup_home: Path, relative_path: Path, kind: str) -> tuple[Path, os.stat_result]:
    candidate = backup_home / relative_path
    try:
        backup_home_resolved = backup_home.resolve(strict=True)
        current = backup_home
        file_stat = None
        for part in relative_path.parts:
            current = current / part
            file_stat = current.lstat()
            if stat.S_ISLNK(file_stat.st_mode):
                raise HelperError("invalid_request", f"{kind} must not contain symlinks.")
        assert file_stat is not None
        candidate_resolved = candidate.resolve(strict=True)
    except OSError:
        raise HelperError("invalid_request", f"{kind} does not exist.")

    if candidate_resolved == backup_home_resolved or backup_home_resolved not in candidate_resolved.parents:
        raise HelperError("invalid_request", f"{kind} is outside the backup home.")

    return candidate_resolved, file_stat


def _list_backup_dirs(backup_home: Path) -> list[dict[str, Any]]:
    backups: list[dict[str, Any]] = []

    def visit(directory: Path, relative_parts: list[str], depth: int) -> None:
        if depth > MAX_BACKUP_LIST_DEPTH or len(backups) >= MAX_BACKUPS_LISTED:
            return

        try:
            with os.scandir(directory) as entries:
                sorted_entries = sorted(entries, key=lambda entry: entry.name)
        except OSError:
            return

        for entry in sorted_entries:
            if len(backups) >= MAX_BACKUPS_LISTED:
                return
            if depth == 1 and entry.name in RESERVED_BACKUP_HOME_NAMES:
                continue
            if re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]{0,63}", entry.name) is None:
                continue

            try:
                file_stat = entry.stat(follow_symlinks=False)
            except OSError:
                continue
            if not stat.S_ISDIR(file_stat.st_mode):
                continue

            relative_path = Path(*relative_parts, entry.name)
            path = backup_home / relative_path
            backups.append({
                "id": relative_path.as_posix(),
                "path": path.resolve(strict=False).as_posix(),
                "modifiedTime": int(file_stat.st_mtime),
            })
            visit(path, [*relative_parts, entry.name], depth + 1)

    visit(backup_home, [], 1)

    return backups


def _require_log_id(value: Any) -> str:
    log_id = require_string(value, "logId")
    if re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]{0,127}", log_id) is None:
        raise HelperError("invalid_request", "logId must be a safe log file name.")
    if not log_id.endswith(".log"):
        raise HelperError("invalid_request", "logId must name a log file.")

    return log_id


def _log_path(backup_home: Path, log_id: str, user: dict[str, Any]) -> tuple[Path, os.stat_result]:
    log_dir = _checked_log_dir(backup_home, user)
    assert log_dir is not None
    log_path = log_dir / log_id
    try:
        file_stat = log_path.lstat()
    except OSError:
        raise HelperError("invalid_request", "logId does not exist.")

    if not stat.S_ISREG(file_stat.st_mode):
        raise HelperError("invalid_request", "logId must name a regular file, not a symlink or directory.")
    _require_private_regular_file(file_stat, user, "log file")

    return log_path, file_stat


def _list_log_files(backup_home: Path, user: dict[str, Any]) -> list[dict[str, Any]]:
    log_dir = _checked_log_dir(backup_home, user, missing_ok=True)
    if log_dir is None:
        return []

    result = []
    try:
        with os.scandir(log_dir) as entries:
            sorted_entries = sorted(entries, key=lambda entry: entry.name)
    except OSError:
        raise HelperError("invalid_request", "log directory could not be read.")

    for entry in sorted_entries:
        if re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]{0,127}", entry.name) is None or not entry.name.endswith(".log"):
            continue
        try:
            file_stat = entry.stat(follow_symlinks=False)
        except OSError:
            continue
        if not stat.S_ISREG(file_stat.st_mode):
            continue
        if os.name == "posix" and (file_stat.st_uid != user["uid"] or stat.S_IMODE(file_stat.st_mode) != JOB_LOG_FILE_MODE):
            continue

        result.append({
            "id": entry.name,
            "path": (log_dir / entry.name).as_posix(),
            "sizeBytes": file_stat.st_size,
            "modifiedTime": int(file_stat.st_mtime),
        })

    return result


def _read_log_tail(log_path: Path, file_stat: os.stat_result, max_bytes: int) -> tuple[str, bool]:
    flags = os.O_RDONLY
    if hasattr(os, "O_CLOEXEC"):
        flags |= os.O_CLOEXEC
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW

    fd = None
    try:
        fd = os.open(log_path, flags)
        opened_stat = os.fstat(fd)
        if os.name == "posix" and (opened_stat.st_dev != file_stat.st_dev or opened_stat.st_ino != file_stat.st_ino):
            raise HelperError("invalid_request", "log file changed while opening.")
        if not stat.S_ISREG(opened_stat.st_mode):
            raise HelperError("invalid_request", "log file is not a regular file.")

        size = opened_stat.st_size
        offset = max(0, size - max_bytes)
        os.lseek(fd, offset, os.SEEK_SET)
        payload = os.read(fd, max_bytes)
    except HelperError:
        raise
    except OSError:
        raise HelperError("invalid_request", "log file could not be read.")
    finally:
        if fd is not None:
            os.close(fd)

    return payload.decode("utf-8", errors="replace"), size > max_bytes


def _require_valid_backup_home(backup_home: Path, config: HelperConfig, user: dict[str, Any], write: bool) -> Path:
    checks, _backup_home_stat = _backup_home_checks(backup_home, config, user, write=write)
    if not _validation_allows_operation(checks):
        raise HelperError("invalid_request", "backupHome is not valid.")

    try:
        return backup_home.resolve(strict=True)
    except OSError:
        raise HelperError("invalid_request", "backupHome is not valid.")


def _require_private_regular_file(file_stat: os.stat_result, user: dict[str, Any], label: str) -> None:
    if os.name != "posix":
        return

    if file_stat.st_uid != user["uid"]:
        raise HelperError("invalid_request", f"{label} must be owned by the effective helper user.")

    if stat.S_IMODE(file_stat.st_mode) != JOB_STORE_MODE:
        raise HelperError("invalid_request", f"{label} permissions must be {JOB_STORE_MODE:04o}.")


def _profile_truthy(value: str | None) -> bool:
    return value is not None and value.strip().lower() in {"1", "true", "yes", "on"}


def _profile_week_days(value: str | None) -> str:
    parts = [part.strip() for part in (value or "").split(",")]
    if not value or any(part not in {"0", "1", "2", "3", "4", "5", "6"} for part in parts):
        raise HelperError("invalid_config", "profile weekly schedule must list days from 0 to 6.")

    days = [int(part) for part in parts]
    if len(set(days)) != len(days):
        raise HelperError("invalid_config", "profile weekly schedule must list unique days from 0 to 6.")

    return ",".join(str(day) for day in sorted(days))


def _profile_schedule(options: dict[str, str], prefix: str) -> dict[str, str] | None:
    if not _profile_truthy(options.get(f"{prefix}_backups_enabled")):
        return None

    try:
        interval = max(1, int(options.get(f"{prefix}_backups_interval", "1")))
    except ValueError:
        interval = 1

    frequency = options.get(f"{prefix}_backups_frequency", "0")
    minute = options.get(f"{prefix}_backups_minute", "0")
    hour = options.get(f"{prefix}_backups_hour", "0")
    if frequency == "0":
        schedule = {
            "minute": minute,
            "hour": "*" if interval == 1 else f"*/{min(interval, 23)}",
            "dayOfMonth": "*",
            "month": "*",
            "dayOfWeek": "*",
        }
    elif frequency == "1":
        schedule = {
            "minute": minute,
            "hour": hour,
            "dayOfMonth": "*" if interval == 1 else f"*/{min(interval, 31)}",
            "month": "*",
            "dayOfWeek": "*",
        }
    elif frequency == "2":
        schedule = {
            "minute": minute,
            "hour": hour,
            "dayOfMonth": "*",
            "month": "*",
            "dayOfWeek": _profile_week_days(options.get(f"{prefix}_backups_week_days")),
        }
    elif frequency == "3":
        schedule = {
            "minute": minute,
            "hour": hour,
            "dayOfMonth": options.get(f"{prefix}_backups_month_day", "1"),
            "month": "*" if interval == 1 else f"*/{min(interval, 12)}",
            "dayOfWeek": "*",
        }
    else:
        raise HelperError("invalid_config", "profile schedule frequency is not supported.")

    return _require_schedule(schedule)


def _read_profile_config(path: Path, file_stat: os.stat_result) -> configparser.RawConfigParser:
    flags = os.O_RDONLY
    if hasattr(os, "O_CLOEXEC"):
        flags |= os.O_CLOEXEC
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW

    fd = None
    try:
        fd = os.open(path, flags)
        opened_stat = os.fstat(fd)
        if os.name == "posix" and (opened_stat.st_dev != file_stat.st_dev or opened_stat.st_ino != file_stat.st_ino):
            raise HelperError("invalid_request", "profile configuration changed while opening.")
        if not stat.S_ISREG(opened_stat.st_mode):
            raise HelperError("invalid_request", "profile configuration must be a regular file.")
        parser = configparser.RawConfigParser()
        parser.optionxform = str.lower
        with os.fdopen(fd, encoding="utf-8") as config_file:
            fd = None
            parser.read_file(config_file)
    except HelperError:
        raise
    except (OSError, UnicodeDecodeError, configparser.Error):
        raise HelperError("invalid_config", "profile configuration could not be read.")
    finally:
        if fd is not None:
            os.close(fd)

    return parser


def _profile_options(parser: configparser.RawConfigParser, section: str) -> dict[str, str]:
    if not parser.has_section(section):
        return {}

    return {key: value.strip() for key, value in parser.items(section)}


def _derived_profile_jobs(backup_home: Path, config: HelperConfig) -> dict[str, dict[str, Any]]:
    target_user = resolve_target_user(config)
    jobs: dict[str, dict[str, Any]] = {}
    try:
        entries = sorted(os.scandir(backup_home), key=lambda entry: entry.name)
    except OSError:
        raise HelperError("invalid_request", "profile configurations could not be read.")

    for entry in entries:
        if not entry.name.endswith(".cnf") or entry.name in PROFILE_CONFIG_IGNORES:
            continue
        try:
            file_stat = entry.stat(follow_symlinks=False)
        except OSError:
            raise HelperError("invalid_request", "profile configuration could not be inspected.")
        if not stat.S_ISREG(file_stat.st_mode):
            continue
        if file_stat.st_size > MAX_CONFIG_BYTES:
            raise HelperError("invalid_config", "profile configuration is too large.")

        profile_path = backup_home / entry.name
        _validate_option_file_permissions(profile_path.as_posix(), target_user.uid)
        parser = _read_profile_config(profile_path, file_stat)
        manager = _profile_options(parser, "meb_manager")
        mysqlbackup = _profile_options(parser, "mysqlbackup")
        output_directory = mysqlbackup.get("backup_dir")
        if not output_directory:
            continue

        profile_id = require_safe_identifier(manager.get("uuid") or profile_path.stem, "profile uuid")
        storage_type = manager.get("storage_type") or ("cloud" if mysqlbackup.get("cloud_service") else "local")
        base_job = {
            "outputDirectory": output_directory,
            "storageType": storage_type,
            "defaultsFile": profile_path.as_posix(),
        }
        candidates = [
            {
                **base_job,
                "id": f"{profile_id}-backup-full",
                "backupMode": "full",
                **({"schedule": schedule} if (schedule := _profile_schedule(manager, "full")) else {}),
            },
            {
                **base_job,
                "id": f"{profile_id}-backup-incremental",
                "backupMode": "incremental",
                "incrementalBase": mysqlbackup.get("incremental_base", "history:last_backup"),
                **({"schedule": schedule} if (schedule := _profile_schedule(manager, "inc")) else {}),
            },
        ]
        for candidate in candidates:
            job = _require_job_definition(candidate, config, target_user)
            if job["id"] in jobs:
                raise HelperError("invalid_config", "profile configurations contain duplicate job ids.")
            jobs[job["id"]] = job

    if len(jobs) > MAX_JOBS:
        raise HelperError("invalid_config", "profile configurations contain too many jobs.")
    _validate_non_overlapping_job_schedules(jobs)

    return jobs


def _read_json_store(
    path: Path,
    config: HelperConfig,
    user: dict[str, Any],
    *,
    missing_ok: bool,
    label: str,
) -> dict[str, Any]:
    path_check, file_stat = _path_check(f"{label}.path", path, "regular file", missing_ok=missing_ok)
    if file_stat is None:
        if missing_ok and path_check["status"] == "pass":
            return {}
        raise HelperError("invalid_request", f"{label} file is not usable.")

    _require_private_regular_file(file_stat, user, f"{label} file")

    flags = os.O_RDONLY
    if hasattr(os, "O_CLOEXEC"):
        flags |= os.O_CLOEXEC
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW

    fd = None
    try:
        fd = os.open(path, flags)
        opened_stat = os.fstat(fd)
        if os.name == "posix" and (opened_stat.st_dev != file_stat.st_dev or opened_stat.st_ino != file_stat.st_ino):
            raise HelperError("invalid_request", f"{label} file changed while opening.")
        if not stat.S_ISREG(opened_stat.st_mode):
            raise HelperError("invalid_request", f"{label} file is not a regular file.")
        payload = os.read(fd, MAX_JOB_STORE_BYTES + 1)
    except OSError:
        raise HelperError("invalid_request", f"{label} file could not be read.")
    finally:
        if fd is not None:
            os.close(fd)

    if len(payload) > MAX_JOB_STORE_BYTES:
        raise HelperError("invalid_request", f"{label} file is too large.")

    try:
        return require_dict(json.loads(payload.decode("utf-8")), f"{label} file")
    except (UnicodeDecodeError, json.JSONDecodeError):
        raise HelperError("invalid_config", f"{label} file is malformed.")


def _read_private_output(path: Path, config: HelperConfig, user: dict[str, Any]) -> str:
    path_check, file_stat = _path_check("restoreOutput.path", path, "regular file", missing_ok=True)
    if file_stat is None:
        if path_check["status"] == "pass":
            return ""
        raise HelperError("invalid_request", "restore output file is not usable.")

    _require_private_regular_file(file_stat, user, "restore output file")
    flags = os.O_RDONLY
    if hasattr(os, "O_CLOEXEC"):
        flags |= os.O_CLOEXEC
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW

    fd = None
    try:
        fd = os.open(path, flags)
        opened_stat = os.fstat(fd)
        if os.name == "posix" and (opened_stat.st_dev != file_stat.st_dev or opened_stat.st_ino != file_stat.st_ino):
            raise HelperError("invalid_request", "restore output file changed while opening.")
        payload = os.read(fd, config.max_output_bytes + 1)
    except OSError:
        raise HelperError("invalid_request", "restore output file could not be read.")
    finally:
        if fd is not None:
            os.close(fd)

    if len(payload) > config.max_output_bytes:
        payload = payload[:config.max_output_bytes]

    return payload.decode("utf-8", errors="replace")


def _write_json_store(path: Path, value: dict[str, Any]) -> None:
    payload = json.dumps(value, indent=2, sort_keys=True)
    if len(payload.encode("utf-8")) > MAX_JOB_STORE_BYTES:
        raise HelperError("invalid_request", f"{path.name} would be too large.")

    fd = None
    temp_name = None
    try:
        fd, temp_name = tempfile.mkstemp(prefix=f".{path.name}.", suffix=".tmp", dir=path.parent, text=True)
        if os.name == "posix":
            os.chmod(temp_name, JOB_STORE_MODE)

        with os.fdopen(fd, "w", encoding="utf-8") as json_file:
            fd = None
            json_file.write(payload)
            json_file.write("\n")
            json_file.flush()
            os.fsync(json_file.fileno())

        os.replace(temp_name, path)
        temp_name = None
        if os.name == "posix":
            try:
                os.chmod(path, JOB_STORE_MODE, follow_symlinks=False)
            except NotImplementedError:
                os.chmod(path, JOB_STORE_MODE)
            directory_fd = os.open(path.parent, os.O_RDONLY)
            try:
                os.fsync(directory_fd)
            finally:
                os.close(directory_fd)
    finally:
        if fd is not None:
            os.close(fd)
        if temp_name is not None:
            try:
                os.unlink(temp_name)
            except FileNotFoundError:
                pass


def _cloud_object_name() -> str:
    return time.strftime("%Y-%m-%d_%H-%M-%S", time.localtime())


def _cloud_object_option(defaults_file: str) -> str:
    config = configparser.RawConfigParser()
    config.optionxform = str.lower
    try:
        with open(defaults_file, encoding="utf-8") as config_file:
            config.read_file(config_file)
    except (OSError, configparser.Error):
        raise HelperError("invalid_config", "cloud storage profile options could not be read.")

    service = config.get("mysqlbackup", "cloud_service", fallback="").strip().lower()
    option = CLOUD_OBJECT_OPTION_BY_SERVICE.get(service)
    if option is None:
        raise HelperError("invalid_config", "cloud_service is required for cloud backup jobs.")

    return option


def _require_job_definition(value: Any, config: HelperConfig, target_user: TargetUser) -> dict[str, Any]:
    job = require_dict(value, "job")
    reject_unknown_fields(job, {
        "id",
        "backupMode",
        "outputDirectory",
        "storageType",
        "baseBackupDirectory",
        "incrementalBase",
        "defaultsFile",
        "schedule",
    }, "job")

    job_id = require_safe_identifier(job.get("id"), "job.id")
    backup_mode = require_string(job.get("backupMode"), "job.backupMode")
    if backup_mode not in {"full", "incremental"}:
        raise HelperError("invalid_request", "job.backupMode is not supported.")
    storage_type = require_string(job.get("storageType", "local"), "job.storageType")
    if storage_type not in {"local", "cloud"}:
        raise HelperError("invalid_request", "job.storageType is not supported.")

    output_directory = _path_under_roots(
        require_string(job.get("outputDirectory"), "job.outputDirectory"),
        config.backup_roots,
        "job.outputDirectory",
    )
    defaults_file = _path_under_roots(
        require_string(job.get("defaultsFile"), "job.defaultsFile"),
        config.option_file_roots,
        "job.defaultsFile",
        file=True,
    )
    _validate_option_file_permissions(defaults_file, target_user.uid)

    result = {
        "id": job_id,
        "backupMode": backup_mode,
        "storageType": storage_type,
        "outputDirectory": output_directory,
        "defaultsFile": defaults_file,
    }

    if backup_mode == "full":
        if job.get("baseBackupDirectory") is not None:
            raise HelperError("invalid_request", "job.baseBackupDirectory is only supported for incremental jobs.")
        if job.get("incrementalBase") is not None:
            raise HelperError("invalid_request", "job.incrementalBase is only supported for incremental jobs.")
    else:
        incremental_base = job.get("incrementalBase")
        if incremental_base is None:
            if job.get("baseBackupDirectory") is None:
                result["incrementalBase"] = "history:last_backup"
            else:
                base_directory = _path_under_roots(
                    require_string(job.get("baseBackupDirectory"), "job.baseBackupDirectory"),
                    config.backup_roots,
                    "job.baseBackupDirectory",
                )
                result["baseBackupDirectory"] = base_directory
                result["incrementalBase"] = f"dir:{base_directory}"
        else:
            incremental_base = require_string(incremental_base, "job.incrementalBase")
            if incremental_base in INCREMENTAL_BASE_VALUES:
                if job.get("baseBackupDirectory") is not None:
                    raise HelperError(
                        "invalid_request",
                        "job.baseBackupDirectory cannot be combined with a history incremental base.",
                    )
                result["incrementalBase"] = incremental_base
            elif incremental_base.startswith("dir:"):
                base_directory = _path_under_roots(
                    incremental_base[4:],
                    config.backup_roots,
                    "job.incrementalBase",
                )
                result["baseBackupDirectory"] = base_directory
                result["incrementalBase"] = f"dir:{base_directory}"
            else:
                raise HelperError("invalid_request", "job.incrementalBase is not supported.")

    if job.get("schedule") is not None:
        result["schedule"] = _require_schedule(job.get("schedule"))

    return result


def _mysqlbackup_plan_for_job(job: dict[str, Any], config: HelperConfig) -> ProcessPlan:
    target_user = resolve_target_user(config)
    args = [
        f"--defaults-file={job['defaultsFile']}",
        f"--login-path={config.login_path}",
        "--with-timestamp",
    ]

    if job["storageType"] == "cloud":
        args.append(f"--backup-dir={job['outputDirectory']}")
        args.append("--backup-image=-")
        args.append(f"{_cloud_object_option(job['defaultsFile'])}={_cloud_object_name()}")
        if job["backupMode"] == "incremental":
            args.extend([
                "--incremental",
                f"--incremental-base={job['incrementalBase']}",
            ])
        args.append("backup-to-image")
    elif job["backupMode"] == "full":
        args.extend([f"--backup-dir={job['outputDirectory']}", "backup-and-apply-log"])
    else:
        args.extend([
            "--incremental",
            f"--incremental-base={job['incrementalBase']}",
            f"--incremental-backup-dir={job['outputDirectory']}",
            "backup",
        ])

    env = {
        "PATH": r"C:\Windows\System32",
        "SYSTEMROOT": os.environ.get("SystemRoot", r"C:\Windows"),
        "MYSQL_TEST_LOGIN_FILE": config.login_file,
    } if os.name == "nt" else {
        "LANG": "C",
        "LC_ALL": "C",
        "PATH": "/usr/bin:/bin",
        "MYSQL_TEST_LOGIN_FILE": config.login_file,
    }

    return ProcessPlan(
        executable=config.mysqlbackup,
        args=args,
        cwd=config.working_directory,
        env=env,
        uid=target_user.uid,
        gid=target_user.gid,
        timeout_ms=config.timeout_ms,
        max_output_bytes=config.max_output_bytes,
        audit_name="jobs.execute",
        account=target_user.account,
    )


def _with_mysqlbackup_progress_file(plan: ProcessPlan, progress_path: Path) -> ProcessPlan:
    args = [
        *plan.args[:-1],
        f"--show-progress=file:{progress_path.as_posix()}",
        "--progress-interval=1",
        plan.args[-1],
    ]

    return replace(plan, args=args)


