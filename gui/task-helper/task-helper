# Schedule operations
def _parse_cron_part(part: str, minimum: int, maximum: int) -> bool:
    if len(part) == 0:
        return False

    step_split = part.split("/")
    if len(step_split) > 2:
        return False

    if len(step_split) == 2:
        if not step_split[1].isdigit():
            return False
        step = int(step_split[1])
        if step < 1 or step > maximum:
            return False

    value = step_split[0]
    if value == "*":
        return True

    bounds = value.split("-")
    if len(bounds) > 2 or any(len(bound) == 0 for bound in bounds):
        return False

    if not all(bound.isdigit() for bound in bounds):
        return False

    start = int(bounds[0])
    if start < minimum or start > maximum:
        return False

    if len(bounds) == 1:
        return True

    end = int(bounds[1])
    return start <= end <= maximum


def _validate_cron_field(value: Any, label: str, minimum: int, maximum: int) -> str:
    field = require_string(value, label)
    if not all(char in "0123456789*,/-" for char in field):
        raise HelperError("invalid_request", f"{label} contains unsupported characters.")

    parts = field.split(",")
    if len(parts) == 0 or any(not _parse_cron_part(part, minimum, maximum) for part in parts):
        raise HelperError("invalid_request", f"{label} is not a supported cron expression.")

    return field


def _expand_cron_field(field: str, minimum: int, maximum: int) -> list[int] | None:
    if field == "*":
        return None

    values: set[int] = set()
    for part in field.split(","):
        step_split = part.split("/")
        step = int(step_split[1]) if len(step_split) == 2 else 1
        value = step_split[0]

        if value == "*":
            start = minimum
            end = maximum
        elif "-" in value:
            start_text, end_text = value.split("-", 1)
            start = int(start_text)
            end = int(end_text)
        else:
            start = int(value)
            end = start

        values.update(range(start, end + 1, step))

    return sorted(values)


def _require_schedule(value: Any) -> dict[str, str]:
    schedule = require_dict(value, "schedule")
    reject_unknown_fields(schedule, {"minute", "hour", "dayOfMonth", "month", "dayOfWeek"}, "schedule")

    return {
        "minute": _validate_cron_field(schedule.get("minute"), "schedule.minute", 0, 59),
        "hour": _validate_cron_field(schedule.get("hour"), "schedule.hour", 0, 23),
        "dayOfMonth": _validate_cron_field(schedule.get("dayOfMonth"), "schedule.dayOfMonth", 1, 31),
        "month": _validate_cron_field(schedule.get("month"), "schedule.month", 1, 12),
        "dayOfWeek": _validate_cron_field(schedule.get("dayOfWeek"), "schedule.dayOfWeek", 0, 7),
    }


def _require_job(params: Any, label: str, *, with_schedule: bool) -> tuple[str, dict[str, str] | None]:
    request = require_dict(params, f"{label} params")
    allowed = {"jobId", "schedule"} if with_schedule else {"jobId"}
    reject_unknown_fields(request, allowed, f"{label} params")

    job_id = require_safe_identifier(request.get("jobId"), "jobId")
    schedule = _require_schedule(request.get("schedule")) if with_schedule else None

    return job_id, schedule


def _managed_begin(job_id: str) -> str:
    return f"# BEGIN mysql-workbench-managed:{job_id}"


def _managed_end(job_id: str) -> str:
    return f"# END mysql-workbench-managed:{job_id}"


def _managed_block_indexes(lines: list[str], job_id: str) -> tuple[int, int] | None:
    begin = _managed_begin(job_id)
    end = _managed_end(job_id)
    begin_indexes = [index for index, line in enumerate(lines) if line == begin]
    end_indexes = [index for index, line in enumerate(lines) if line == end]

    if len(begin_indexes) == 0 and len(end_indexes) == 0:
        return None

    if len(begin_indexes) != 1 or len(end_indexes) != 1 or end_indexes[0] <= begin_indexes[0]:
        raise HelperError("operation_failed", "Existing managed crontab block is malformed.")

    return begin_indexes[0], end_indexes[0]


def remove_managed_job_block(existing_crontab: str, job_id: str) -> str:
    lines = existing_crontab.splitlines()
    block_indexes = _managed_block_indexes(lines, job_id)
    if block_indexes is None:
        return existing_crontab.rstrip()

    begin_index, end_index = block_indexes
    result = lines[:begin_index] + lines[end_index + 1:]

    compacted = "\n".join(result)
    while "\n\n\n" in compacted:
        compacted = compacted.replace("\n\n\n", "\n\n")

    return compacted.rstrip()


def _cron_command_path(path: str) -> str:
    candidate = path
    if re.search(r"\s", candidate):
        raise HelperError("invalid_config", "config.jobRunner must not contain whitespace.")

    if re.fullmatch(r"/[A-Za-z0-9._/+@:-]+", candidate) is None:
        raise HelperError("invalid_config", "config.jobRunner is not safe to embed in crontab.")

    try:
        validate_executable_reference(candidate)
    except HelperError as error:
        raise HelperError("invalid_config", f"config.jobRunner is invalid: {error.message}")

    return candidate


def _windows_command_path(path: str) -> str:
    if "\0" in path:
        raise HelperError("invalid_config", "config.jobRunner contains a NUL byte.")

    if os.name == "nt":
        try:
            validate_executable_reference(path)
        except HelperError as error:
            raise HelperError("invalid_config", f"config.jobRunner is invalid: {error.message}")
    elif re.fullmatch(r"[A-Za-z]:\\[^<>|?*\"]+", path) is None and re.fullmatch(r"/[A-Za-z0-9._/+@:-]+", path) is None:
        raise HelperError("invalid_config", "config.jobRunner is not a safe Windows command path.")

    return path


def _scheduled_backup_home(config: HelperConfig) -> str:
    backup_home = config.backup_home
    if not backup_home or not Path(backup_home).is_absolute() or "\0" in backup_home:
        raise HelperError("invalid_config", "config.backupHome must be an absolute path.")

    return backup_home


def _scheduled_job_arguments(config: HelperConfig, job_id: str) -> list[str]:
    return ["--backup-home", _scheduled_backup_home(config), "run-job", job_id]


def render_managed_job_block(config: HelperConfig, job_id: str, schedule: dict[str, str]) -> str:
    job_runner = _cron_command_path(config.job_runner)
    backup_home = shlex.quote(_scheduled_backup_home(config))
    cron_line = " ".join([
        schedule["minute"],
        schedule["hour"],
        schedule["dayOfMonth"],
        schedule["month"],
        schedule["dayOfWeek"],
        job_runner,
        "--backup-home",
        backup_home,
        "run-job",
        job_id,
    ])

    return "\n".join([
        _managed_begin(job_id),
        "# Managed by MySQL Workbench task helper. Do not edit this block.",
        cron_line,
        _managed_end(job_id),
    ])


def install_managed_job_block(
    existing_crontab: str,
    config: HelperConfig,
    job_id: str,
    schedule: dict[str, str],
) -> str:
    cleaned = remove_managed_job_block(existing_crontab, job_id)
    block = render_managed_job_block(config, job_id, schedule)

    return f"{cleaned + chr(10) + chr(10) if cleaned else ''}{block}\n"


def _scheduler_backend(config: HelperConfig) -> str:
    if config.scheduler_backend != "platform":
        return config.scheduler_backend

    if sys.platform == "darwin":
        return "launchd"

    if os.name == "nt":
        return "schtasks"

    return "cron"


def _launchd_label(job_id: str) -> str:
    return f"com.mysql.workbench.helper.{job_id}"


def _launchd_calendar_intervals(schedule: dict[str, str]) -> list[dict[str, int]]:
    fields = {
        "Minute": _expand_cron_field(schedule["minute"], 0, 59),
        "Hour": _expand_cron_field(schedule["hour"], 0, 23),
        "Day": _expand_cron_field(schedule["dayOfMonth"], 1, 31),
        "Month": _expand_cron_field(schedule["month"], 1, 12),
        "Weekday": _expand_cron_field(schedule["dayOfWeek"], 0, 7),
    }
    if fields["Day"] is not None and fields["Weekday"] is not None:
        raise HelperError("invalid_request", "launchd schedules must not restrict both dayOfMonth and dayOfWeek.")

    restricted = [(key, value) for key, value in fields.items() if value is not None]
    combinations = 1
    for _key, value in restricted:
        combinations *= len(value)

    if combinations > 1024:
        raise HelperError("invalid_request", "schedule expands to too many launchd calendar intervals.")

    intervals: list[dict[str, int]] = []
    for values in itertools.product(*(value for _key, value in restricted)):
        item: dict[str, int] = {}
        for (key, _field_values), value in zip(restricted, values, strict=True):
            item[key] = 0 if key == "Weekday" and value == 7 else value
        intervals.append(item)

    return intervals or [{}]


def _render_launchd_plist(config: HelperConfig, job_id: str, schedule: dict[str, str]) -> bytes:
    target_user = resolve_target_user(config)
    account = target_user.account or config.target_user_name
    job_runner = _cron_command_path(config.job_runner)

    return plistlib.dumps({
        "Label": _launchd_label(job_id),
        "ProgramArguments": [job_runner, *_scheduled_job_arguments(config, job_id)],
        "StartCalendarInterval": _launchd_calendar_intervals(schedule),
        "UserName": account,
    }, sort_keys=True)


def _write_launchd_plist(config: HelperConfig, job_id: str, payload: bytes) -> Path:
    plist_dir = Path(config.launchd_plist_dir)
    try:
        plist_dir.mkdir(mode=0o700, parents=True, exist_ok=True)
        plist_dir = plist_dir.resolve(strict=True)
    except OSError as error:
        raise HelperError("operation_failed", f"Unable to prepare launchd job directory: {error}.")

    if not plist_dir.is_dir():
        raise HelperError("invalid_config", "config.launchdPlistDir must be a directory.")

    target_path = plist_dir / f"{_launchd_label(job_id)}.plist"
    with tempfile.NamedTemporaryFile("wb", dir=plist_dir, delete=False) as file:
        file.write(payload)
        temporary_path = Path(file.name)

    os.chmod(temporary_path, 0o644)
    if os.name == "posix" and os.geteuid() == 0:
        os.chown(temporary_path, 0, 0)

    os.replace(temporary_path, target_path)

    return target_path


def _launchctl_plan(config: HelperConfig, args: list[str]) -> ProcessPlan:
    return ProcessPlan(
        executable=config.launchctl,
        args=args,
        cwd=config.working_directory,
        env={"LANG": "C", "LC_ALL": "C", "PATH": "/usr/bin:/bin"},
        uid=os.geteuid() if os.name == "posix" else None,
        gid=os.getegid() if os.name == "posix" else None,
        timeout_ms=config.timeout_ms,
        max_output_bytes=config.max_output_bytes,
        audit_name="launchctl",
    )


def _launchd_domain() -> str:
    if os.name == "posix":
        return f"gui/{os.geteuid()}"

    return "gui/0"


def _install_launchd_job(config: HelperConfig, job_id: str, schedule: dict[str, str], dry_run: bool) -> Any:
    plist_payload = _render_launchd_plist(config, job_id, schedule)

    if dry_run:
        return {"plist": plist_payload.decode("utf-8"), "label": _launchd_label(job_id)}

    plist_path = _write_launchd_plist(config, job_id, plist_payload)
    label = _launchd_label(job_id)
    domain = _launchd_domain()
    run_process_plan(_launchctl_plan(config, ["bootout", f"{domain}/{label}"]))

    result = run_process_plan(_launchctl_plan(config, ["bootstrap", domain, plist_path.as_posix()]))

    return scheduler_status(result, "installed", "Installing the scheduled backup job")


def _remove_launchd_job(config: HelperConfig, job_id: str, dry_run: bool) -> Any:
    label = _launchd_label(job_id)
    plist_path = Path(config.launchd_plist_dir) / f"{label}.plist"

    if dry_run:
        return {"label": label, "plistPath": plist_path.as_posix()}

    process_result = run_process_plan(_launchctl_plan(config, ["bootout", f"{_launchd_domain()}/{label}"]))
    result = scheduler_status(
        process_result,
        "removed",
        "Removing the scheduled backup job",
        ("no such process", "not found"),
    )
    if result["status"] in {"removed", "notFound"}:
        try:
            plist_path.unlink()
        except FileNotFoundError:
            pass

    return result


def _single_windows_schedule_value(schedule: dict[str, str], key: str, minimum: int, maximum: int) -> int:
    values = _expand_cron_field(schedule[key], minimum, maximum)
    if values is None or len(values) != 1:
        raise HelperError("invalid_request", "Windows Task Scheduler backend requires single minute and hour values.")

    return values[0]


def _windows_task_name(config: HelperConfig, job_id: str) -> str:
    return f"{config.windows_task_folder}\\{job_id}"


def _windows_day_name(value: int) -> str:
    return {
        0: "Sunday",
        1: "Monday",
        2: "Tuesday",
        3: "Wednesday",
        4: "Thursday",
        5: "Friday",
        6: "Saturday",
        7: "Sunday",
    }[value]


def _windows_month_name(value: int) -> str:
    return {
        1: "January",
        2: "February",
        3: "March",
        4: "April",
        5: "May",
        6: "June",
        7: "July",
        8: "August",
        9: "September",
        10: "October",
        11: "November",
        12: "December",
    }[value]


def _render_windows_task_xml(config: HelperConfig, job_id: str, schedule: dict[str, str]) -> bytes:
    target_user = resolve_target_user(config)
    if target_user.account is None:
        raise HelperError("invalid_config", "Windows scheduled tasks require a configured target account.")

    minute = _single_windows_schedule_value(schedule, "minute", 0, 59)
    hour = _single_windows_schedule_value(schedule, "hour", 0, 23)

    root = ET.Element("Task", {
        "version": "1.4",
        "xmlns": "http://schemas.microsoft.com/windows/2004/02/mit/task",
    })
    principals = ET.SubElement(root, "Principals")
    principal = ET.SubElement(principals, "Principal", {"id": "Author"})
    ET.SubElement(principal, "UserId").text = target_user.account
    ET.SubElement(principal, "LogonType").text = target_user.windows_logon_type
    ET.SubElement(principal, "RunLevel").text = "LeastPrivilege"
    triggers = ET.SubElement(root, "Triggers")
    start_boundary = f"2026-01-01T{hour:02d}:{minute:02d}:00"
    trigger = ET.SubElement(triggers, "CalendarTrigger")
    ET.SubElement(trigger, "StartBoundary").text = start_boundary
    ET.SubElement(trigger, "Enabled").text = "true"

    days_of_month = _expand_cron_field(schedule["dayOfMonth"], 1, 31)
    months = _expand_cron_field(schedule["month"], 1, 12)
    days_of_week = _expand_cron_field(schedule["dayOfWeek"], 0, 7)
    if days_of_month is not None:
        if days_of_week is not None:
            raise HelperError(
                "invalid_request",
                "Windows Task Scheduler schedules must not restrict both dayOfMonth and dayOfWeek.",
            )
        schedule_by_month = ET.SubElement(trigger, "ScheduleByMonth")
        days = ET.SubElement(schedule_by_month, "DaysOfMonth")
        for day in days_of_month:
            ET.SubElement(days, "Day").text = str(day)
        selected_months = ET.SubElement(schedule_by_month, "Months")
        for month in months or range(1, 13):
            ET.SubElement(selected_months, _windows_month_name(month))
    elif months is not None:
        raise HelperError(
            "invalid_request",
            "Windows Task Scheduler requires dayOfMonth when month is restricted.",
        )
    elif days_of_week is None:
        schedule_by_day = ET.SubElement(trigger, "ScheduleByDay")
        ET.SubElement(schedule_by_day, "DaysInterval").text = "1"
    else:
        schedule_by_week = ET.SubElement(trigger, "ScheduleByWeek")
        ET.SubElement(schedule_by_week, "WeeksInterval").text = "1"
        days = ET.SubElement(schedule_by_week, "DaysOfWeek")
        for day in days_of_week:
            ET.SubElement(days, _windows_day_name(day))

    settings = ET.SubElement(root, "Settings")
    ET.SubElement(settings, "MultipleInstancesPolicy").text = "Queue"
    ET.SubElement(settings, "ExecutionTimeLimit").text = "PT24H"
    actions = ET.SubElement(root, "Actions", {"Context": "Author"})
    exec_action = ET.SubElement(actions, "Exec")
    ET.SubElement(exec_action, "Command").text = _windows_command_path(config.job_runner)
    ET.SubElement(exec_action, "Arguments").text = subprocess.list2cmdline(_scheduled_job_arguments(config, job_id))

    return ET.tostring(root, encoding="utf-8", xml_declaration=True)


def _schtasks_plan(config: HelperConfig, args: list[str]) -> ProcessPlan:
    return ProcessPlan(
        executable=config.schtasks,
        args=args,
        cwd=config.working_directory,
        env={"PATH": r"C:\Windows\System32"},
        uid=None,
        gid=None,
        timeout_ms=config.timeout_ms,
        max_output_bytes=config.max_output_bytes,
        audit_name="schtasks",
    )


def _install_windows_task(config: HelperConfig, job_id: str, schedule: dict[str, str], dry_run: bool) -> Any:
    task_name = _windows_task_name(config, job_id)
    task_xml = _render_windows_task_xml(config, job_id, schedule)

    if dry_run:
        return {"taskName": task_name, "xml": task_xml.decode("utf-8")}

    with tempfile.NamedTemporaryFile("wb", suffix=".xml", delete=False) as file:
        file.write(task_xml)
        task_xml_path = file.name

    try:
        result = run_process_plan(_schtasks_plan(config, [
            "/Create", "/TN", task_name, "/XML", task_xml_path, "/F",
        ]))

        return scheduler_status(result, "installed", "Installing the scheduled backup job")
    finally:
        Path(task_xml_path).unlink(missing_ok=True)


def _remove_windows_task(config: HelperConfig, job_id: str, dry_run: bool) -> Any:
    task_name = _windows_task_name(config, job_id)

    if dry_run:
        return {"taskName": task_name}

    result = run_process_plan(_schtasks_plan(config, ["/Delete", "/TN", task_name, "/F"]))

    return scheduler_status(
        result,
        "removed",
        "Removing the scheduled backup job",
        ("cannot find the file specified", "cannot find the task", "task does not exist"),
    )


