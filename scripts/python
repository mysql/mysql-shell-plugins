#!/usr/bin/env bash
# Copyright (c) 2026, Oracle and/or its affiliates.

set -euo pipefail

for python in python3.13 python3.12 python3.11; do
    if command -v "$python" >/dev/null 2>&1; then
        exec "$python" "$@"
    fi
done

echo "Could not find python3.13, python3.12, or python3.11 in PATH." >&2
exit 127
